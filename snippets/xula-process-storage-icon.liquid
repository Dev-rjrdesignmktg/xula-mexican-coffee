  {%- when 'grind' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9h12l-1.5 11.5h-9z"/><path d="M8 9V6.5h8V9"/><path d="M12 6.5V3.5h4"/></svg>
  {%- when 'chevron' -%}
