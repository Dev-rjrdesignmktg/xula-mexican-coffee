{%- comment -%}
  Xula Process & Storage — inline SVG icons.
  Usage: {% render 'xula-process-storage-icon', icon: 'washed' %}
  Icons: washed | honey | natural | seal | dark | no_fridge | clock | grind | chevron
{%- endcomment -%}

{%- case icon -%}
