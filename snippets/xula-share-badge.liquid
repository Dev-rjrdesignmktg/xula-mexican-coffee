{% comment %}
  Renders a centered badge: author on top, explicit labeled share buttons below.
  Accepts: author, share_url, share_title, pin_image_url
{% endcomment %}
{{ 'xula-share-badge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-share.js' | asset_url }}" defer="defer"></script>

<div
  class="xula-share-badge"
  data-article-share
  data-share-url="{{ share_url }}"
  data-share-title="{{ share_title | escape }}"
>
  {%- if author != blank -%}
    <span class="xula-share-badge__author">by {{ author }}</span>
  {%- endif -%}

  <div class="xula-share-badge__share">
    <span class="xula-share-badge__label">Share this article</span>

    <div class="xula-share-badge__links">
      <a
        class="xula-share-badge__link"
        href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
        <span>Facebook</span>
      </a>
      <a
        class="xula-share-badge__link"
        href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ share_title | url_encode }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.9 2H22l-7.4 8.4L23.3 22h-6.9l-5.4-6.6L4.8 22H1.7l7.9-9-8.4-11h7l4.9 6.1zM17.6 20h1.9L7 4H5z"/></svg>
        <span>X</span>
      </a>
      <a
        class="xula-share-badge__link"
        href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ pin_image_url | url_encode }}&description={{ share_title | url_encode }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.7.2-2.5l1.4-6s-.3-.7-.3-1.7c0-1.6.9-2.8 2.1-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.4-1 3.8-.3 1.1.6 2 1.7 2 2 0 3.5-2.1 3.5-5.2 0-2.7-2-4.6-4.7-4.6-3.2 0-5.1 2.4-5.1 4.9 0 1 .4 2 .9 2.6.1.1.1.2.1.3l-.3 1.4c0 .2-.2.3-.4.2-1.4-.6-2.3-2.6-2.3-4.2 0-3.4 2.5-6.6 7.1-6.6 3.7 0 6.6 2.7 6.6 6.2 0 3.7-2.3 6.7-5.6 6.7-1.1 0-2.1-.6-2.5-1.2l-.7 2.6c-.2 1-.9 2.2-1.3 3A10 10 0 1 0 12 2z"/></svg>
        <span>Pinterest</span>
      </a>
      <button type="button" class="xula-share-badge__link xula-share-badge__link--copy" data-article-share-copy>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10.6 13.4a1 1 0 0 1 0-1.4l3-3a3 3 0 1 1 4.2 4.2l-1.6 1.6a1 1 0 1 1-1.4-1.4l1.6-1.6a1 1 0 1 0-1.4-1.4l-3 3a1 1 0 0 1-1.4 0zm2.8-2.8a1 1 0 0 1 0 1.4l-3 3a3 3 0 1 1-4.2-4.2l1.6-1.6a1 1 0 1 1 1.4 1.4l-1.6 1.6a1 1 0 1 0 1.4 1.4l3-3a1 1 0 0 1 1.4 0z"/></svg>
        <span data-article-share-copy-label>Copy link</span>
      </button>
    </div>
  </div>

  <span class="visually-hidden" role="status" aria-live="polite" data-article-share-status></span>
</div>
