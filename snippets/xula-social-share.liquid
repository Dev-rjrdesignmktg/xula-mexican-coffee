{%- comment -%}
  Xula Social Share — icon badges to share the current page.
  Usage:
    {% render 'xula-social-share' %}
    {% render 'xula-social-share', url: product.url, title: product.title, image: product.featured_image, heading: 'Share' %}
    {% render 'xula-social-share', show_pinterest: false, show_email: false %}

  Params (all optional):
    url, title, image   — default to the current page (canonical_url / page_title)
    heading              — label above the icons, default "Share". Pass false to hide.
    compact               — tighter icon size for quick-buy / sidebar contexts
    show_facebook / show_x / show_pinterest / show_whatsapp / show_email / show_copy_link
                           — booleans, all default true
{%- endcomment -%}

{%- liquid
  assign share_url = url | default: canonical_url
  assign share_title = title | default: page_title
  assign share_image = image

  assign show_fb = true
  if show_facebook == false
    assign show_fb = false
  endif

  assign show_tw = true
  if show_x == false
    assign show_tw = false
  endif

  assign show_pin = true
  if show_pinterest == false
    assign show_pin = false
  endif

  assign show_wa = true
  if show_whatsapp == false
    assign show_wa = false
  endif

  assign show_em = true
  if show_email == false
    assign show_em = false
  endif

  assign show_copy = true
  if show_copy_link == false
    assign show_copy = false
  endif

  assign is_compact = false
  if compact
    assign is_compact = true
  endif

  assign share_heading = 'Share'
  if heading == false or heading == 'false'
    assign share_heading = blank
  elsif heading != blank
    assign share_heading = heading
  endif

  assign whatsapp_text = share_title | append: ' ' | append: share_url
-%}

<div
  class="xula-social-share{% if is_compact %} xula-social-share--compact{% endif %}"
  data-xss-root
  role="group"
  aria-label="{{ share_heading | default: 'Share' }}"
>
  {%- if share_heading != blank -%}
    <p class="xula-social-share__heading">{{ share_heading }}</p>
  {%- endif -%}

  <ul class="xula-social-share__list">
    {%- if show_fb -%}
      <li>
        <a
          class="xula-social-share__link xula-social-share__link--facebook"
          href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Facebook"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-8.1h2.7l.4-3.2h-3.1V7.6c0-.9.3-1.6 1.6-1.6h1.7V3.1C16.5 3 15.5 3 14.3 3c-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4v3.2h2.7V21z"/></svg>
        </a>
      </li>
    {%- endif -%}

    {%- if show_tw -%}
      <li>
        <a
          class="xula-social-share__link xula-social-share__link--x"
          href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&amp;text={{ share_title | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on X"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.5 3h3.1l-6.8 7.8L21.9 21h-6.3l-4.9-6.4L4.9 21H1.8l7.3-8.3L1.5 3h6.4l4.5 5.9zm-1.1 16.2h1.7L7.7 4.7H5.9z"/></svg>
        </a>
      </li>
    {%- endif -%}

    {%- if show_pin -%}
      <li>
        <a
          class="xula-social-share__link xula-social-share__link--pinterest"
          href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}{% if share_image != blank %}&amp;media={{ share_image | image_url: width: 1200 | prepend: 'https:' | url_encode }}{% endif %}&amp;description={{ share_title | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Pinterest"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5A9.5 9.5 0 0 0 8.6 21c-.1-.8-.2-2 0-2.9l1.3-5.6s-.3-.7-.3-1.6c0-1.5.9-2.6 1.9-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.9-4.2-3.9-3 0-4.9 2.3-4.9 4.8 0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.5.3-1.4-.6-2.1-2.2-2.1-4 0-3 2.5-6.5 7.5-6.5 4 0 6.6 2.9 6.6 6 0 4.1-2.3 7.2-5.6 7.2-1.1 0-2.2-.6-2.5-1.3l-.7 2.7c-.2.9-.7 2-1.1 2.7A9.5 9.5 0 1 0 12 2.5z"/></svg>
        </a>
      </li>
    {%- endif -%}

    {%- if show_wa -%}
      <li>
        <a
          class="xula-social-share__link xula-social-share__link--whatsapp"
          href="https://api.whatsapp.com/send?text={{ whatsapp_text | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on WhatsApp"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5a9.4 9.4 0 0 0-8 14.3L2.5 21.5l4.9-1.5A9.4 9.4 0 1 0 12 2.5zm0 17a7.5 7.5 0 0 1-3.9-1.1l-.3-.2-2.7.8.8-2.6-.2-.3A7.6 7.6 0 1 1 12 19.5zm4.2-5.6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1s-.6.8-.7.9-.3.2-.5.1a6.2 6.2 0 0 1-1.8-1.1 6.8 6.8 0 0 1-1.3-1.6c-.1-.2 0-.3.1-.4l.3-.4.2-.3a.5.5 0 0 0 0-.5c-.1-.1-.5-1.3-.7-1.7-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.5 11.2 11.2 0 0 0 4.3 3.8c.6.3 1.1.4 1.4.6a3.4 3.4 0 0 0 1.6 0 2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c-.1-.1-.2-.2-.4-.3z"/></svg>
        </a>
      </li>
    {%- endif -%}

    {%- if show_em -%}
      <li>
        <a
          class="xula-social-share__link xula-social-share__link--email"
          href="mailto:?subject={{ share_title | url_encode }}&amp;body={{ share_url | url_encode }}"
          aria-label="Share by email"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </a>
      </li>
    {%- endif -%}

    {%- if show_copy -%}
      <li>
        <button
          type="button"
          class="xula-social-share__link xula-social-share__link--copy"
          data-xss-copy
          data-xss-url="{{ share_url | escape }}"
          aria-label="Copy link"
        >
          <svg class="xula-social-share__icon-default" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          <svg class="xula-social-share__icon-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden><path d="M5 12.5l4.5 4.5L19 7"/></svg>
        </button>
        <span class="xula-social-share__status visually-hidden" role="status" aria-live="polite" data-xss-status></span>
      </li>
    {%- endif -%}
  </ul>
</div>
