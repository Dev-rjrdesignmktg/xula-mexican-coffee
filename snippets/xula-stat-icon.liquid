{%- comment -%}
  Renders a small line icon for a Xula Origin stat block.
  Accepts:
  - icon: {String} one of mountain, leaf, calendar, home, bean, drop
{%- endcomment -%}
{%- case icon -%}
  {%- when 'mountain' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 20h20L15 6l-4 7-2.5-3L2 20Z" />
    </svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 20c8 0 14-6 16-16-10 0-16 8-16 16Z" />
      <path d="M4 20c2-6 6-10 12-13" />
    </svg>
  {%- when 'calendar' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M16 3v4M8 3v4M3 10h18" />
    </svg>
  {%- when 'home' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 11 12 4l8 7" />
      <path d="M6 10v10h12V10" />
      <path d="M10 20v-6h4v6" />
    </svg>
  {%- when 'bean' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3c4.5 1 8 5.5 8 9.5S16.5 21 12 21 4 17 4 12.5 7.5 4 12 3Z" />
      <path d="M9 19c1-4 1-9 6-14" />
    </svg>
  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3s7 7.5 7 12.5A7 7 0 1 1 5 15.5C5 10.5 12 3 12 3Z" />
    </svg>
{%- endcase -%}
