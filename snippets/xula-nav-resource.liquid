{% comment %}
  One entry of the "Resources" mega menu (a blog, an article or a custom link).
  Reuses the "Our Products" dropdown classes so it inherits its styles and JS.

  Accessibility: plain links in nested lists (disclosure navigation pattern, no
  role="menu"); counts and dates carry screen-reader context.
  Performance: images are decorative (alt="") and only load when the menu opens
  (data-xula-src / data-xula-srcset, hydrated by xula-nav.js).

  Accepts:
  - part: 'link' | 'preview' | 'mobile'
  - position: {Number} 1-based index (drives the preview swap)
  - blog: {Object} blog (optional)
  - article: {Object} article (optional, takes priority over blog)
  - title / url / text / image / badge / badge_style / eyebrow: optional overrides
  - sub: {Boolean} entry nested under its blog
  - children: {String} rendered child <li> items (nested list, 'link' and 'mobile' parts)
  - cta_blog / cta_article: button labels
  - block: {Object} theme block (optional)
{% endcomment %}

{%- liquid
  assign kind = 'link'
  if article != blank
    assign kind = 'article'
  elsif blog != blank
    assign kind = 'blog'
  endif

  assign item_count = nil
  assign item_count_sr = nil
  assign item_date = nil
  assign item_text = nil

  case kind
    when 'article'
      assign item_title = title | default: article.title
      assign item_url = url | default: article.url
      assign item_media = image | default: article.image
      assign item_eyebrow = blog.title | default: 'Article'
      assign item_date = article.published_at
      if article.excerpt != blank
        assign item_text = article.excerpt | strip_html | strip_newlines | truncatewords: 20
      else
        assign item_text = article.content | strip_html | strip_newlines | truncatewords: 20
      endif
      assign item_cta = cta_article
      assign item_handle = 'article-' | append: article.handle
    when 'blog'
      assign latest = blog.articles.first
      assign item_title = title | default: blog.title
      assign item_url = url | default: blog.url
      assign item_media = image | default: latest.image
      assign item_eyebrow = item_title
      assign item_count = blog.articles_count
      if item_count == 1
        assign item_count_sr = item_count | append: ' article'
      else
        assign item_count_sr = item_count | append: ' articles'
      endif
      if latest != blank
        assign item_text = 'Latest: ' | append: latest.title
      endif
      assign item_cta = cta_blog
      assign item_handle = 'blog-' | append: blog.handle
    else
      assign item_title = title
      assign item_url = url
      assign item_media = image
      assign item_eyebrow = 'Resource'
      assign item_cta = cta_blog
      assign item_handle = 'resource-' | append: position
  endcase

  if text != blank
    assign item_text = text
  endif
  if eyebrow != blank
    assign item_eyebrow = eyebrow
  endif
  assign badge_style = badge_style | default: 'accent'

  assign is_current = false
  if item_url == request.path
    assign is_current = true
  endif

  assign item_classes = 'xula-dropdown__collection'
  if sub
    assign item_classes = item_classes | append: ' xula-dropdown__collection--sub'
  endif
  if children != blank
    assign item_classes = item_classes | append: ' xula-dropdown__collection--group'
  endif
-%}

{%- if item_title != blank and item_url != blank and item_url != '#' -%}
  {%- case part -%}
    {%- when 'link' -%}
      <li class="{{ item_classes }}" data-collection="{{ item_handle }}" {% if block %}{{ block.shopify_attributes }}{% endif %}>
        <a
          href="{{ item_url }}"
          class="xula-dropdown__collection-link{% if position == 1 %} is-active{% endif %}"
          data-xula-dropdown-item
          data-xula-preview-target="{{ position }}"
          {% if is_current %}
            aria-current="page"
          {% endif %}
        >
          <span class="xula-dropdown__collection-title">{{ item_title | escape }}</span>
          {%- if item_count != blank -%}
            <span class="xula-dropdown__collection-count xula-type--code">
              <span aria-hidden="true">{{ item_count }}</span>
              <span class="visually-hidden">({{ item_count_sr }})</span>
            </span>
          {%- elsif item_date != blank -%}
            <span class="xula-dropdown__collection-count xula-type--code">
              <time datetime="{{ item_date | date: '%Y-%m-%d' }}">{{ item_date | date: '%b %d' }}</time>
            </span>
          {%- endif -%}
          <svg class="xula-dropdown__collection-arrow" aria-hidden="true" focusable="false" viewBox="0 0 14 10" width="14" height="10">
            <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 5h12M9 1l4 4-4 4"/>
          </svg>
        </a>
        {%- if children != blank -%}
          <ul class="xula-dropdown__sublist" role="list">
            {{ children }}
          </ul>
        {%- endif -%}
      </li>

    {%- when 'preview' -%}
      {%- comment -%}
        Visual duplicate of the list link: hidden from assistive tech and the tab order
        so each destination is announced once.
      {%- endcomment -%}
      <a
        href="{{ item_url }}"
        class="xula-dropdown__feature{% if position == 1 %} is-active{% endif %}"
        data-collection="{{ item_handle }}"
        data-xula-preview="{{ position }}"
        tabindex="-1"
        aria-hidden="true"
      >
        <span class="xula-dropdown__feature-media">
          {%- if item_media != blank -%}
            {%- capture feature_img -%}
              {{
                item_media
                | image_url: width: 1120
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  sizes: '(min-width: 1200px) 560px, 50vw',
                  widths: '400, 560, 800, 1120',
                  alt: '',
                  class: 'xula-dropdown__feature-image'
              }}
            {%- endcapture -%}
            {{ feature_img | replace: ' srcset="', ' data-xula-srcset="' | replace: ' src="', ' data-xula-src="' | replace: '<img ', '<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" ' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-dropdown__feature-image xula-dropdown__feature-image--placeholder' }}
          {%- endif -%}
        </span>

        <span class="xula-dropdown__feature-body">
          {%- if badge != blank -%}
            <span class="xula-dropdown__badge xula-dropdown__badge--{{ badge_style }} xula-type--code">
              {{- badge | escape -}}
            </span>
          {%- endif -%}

          <span class="xula-dropdown__feature-collection xula-type--code">{{ item_eyebrow | escape }}</span>
          <span class="xula-dropdown__feature-title">{{ item_title | escape }}</span>

          {%- if item_date != blank -%}
            <span class="xula-dropdown__price xula-type--code">{{ item_date | time_tag: format: 'date' }}</span>
          {%- elsif item_count_sr != blank -%}
            <span class="xula-dropdown__price xula-type--code">{{ item_count_sr }}</span>
          {%- endif -%}

          {%- if item_text != blank -%}
            <span class="xula-dropdown__feature-text">{{ item_text | escape }}</span>
          {%- endif -%}

          <span class="xula-dropdown__feature-cta">
            {{- item_cta | escape -}}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 14 10" width="14" height="10">
              <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 5h12M9 1l4 4-4 4"/>
            </svg>
          </span>
        </span>
      </a>

    {%- when 'mobile' -%}
      <li class="{{ item_classes }}" data-collection="{{ item_handle }}" {% if block %}{{ block.shopify_attributes }}{% endif %}>
        <a
          href="{{ item_url }}"
          class="xula-dropdown__row"
          {% if is_current %}
            aria-current="page"
          {% endif %}
        >
          <span class="xula-dropdown__row-media" aria-hidden="true">
            {%- if item_media != blank -%}
              {%- capture row_img -%}
                {{
                  item_media
                  | image_url: width: 192
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    sizes: '64px',
                    widths: '64, 128, 192',
                    alt: '',
                    class: 'xula-dropdown__row-image'
                }}
              {%- endcapture -%}
              {{ row_img | replace: ' srcset="', ' data-xula-srcset="' | replace: ' src="', ' data-xula-src="' | replace: '<img ', '<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" ' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-dropdown__row-image xula-dropdown__feature-image--placeholder' }}
            {%- endif -%}
          </span>
          <span class="xula-dropdown__row-body">
            <span class="xula-dropdown__row-title">{{ item_title | escape }}</span>
            <span class="xula-dropdown__row-meta xula-type--code">
              {%- if item_date != blank -%}
                <time datetime="{{ item_date | date: '%Y-%m-%d' }}">{{ item_date | date: '%b %d, %Y' }}</time>
              {%- elsif item_count_sr != blank -%}
                {{ item_count_sr }}
              {%- else -%}
                {{ item_eyebrow | escape }}
              {%- endif -%}
            </span>
          </span>
          {%- if badge != blank -%}
            <span class="xula-dropdown__badge xula-dropdown__badge--{{ badge_style }} xula-type--code">
              {{- badge | escape -}}
            </span>
          {%- endif -%}
        </a>
        {%- if children != blank -%}
          <ul class="xula-dropdown__sublist" role="list">
            {{ children }}
          </ul>
        {%- endif -%}
      </li>
  {%- endcase -%}
{%- endif -%}
