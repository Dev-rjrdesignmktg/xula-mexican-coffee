{%- style -%}
  @font-face {
    font-family: 'Roanne';
    src: url('{{ 'roanne-book.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Roanne';
    src: url('{{ 'roanne-semibold.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Vivala Code';
    src: url('{{ 'vivala-code-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-heading-family: 'Roanne', 'Helvetica Neue', Arial, sans-serif;
    --font-heading-weight: 600;
    --font-body-family: 'Roanne', 'Helvetica Neue', Arial, sans-serif;
    --font-body-weight: 300;
    --font-code-family: 'Vivala Code', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --font-code-weight: 400;
  }
{%- endstyle -%}
