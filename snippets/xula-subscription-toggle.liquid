{%- comment -%}
  Renders the "One-time purchase" vs "Subscribe & Save" selector for the PDP.
  Accepts:
  - product: {Object} product object.
  - product_form_id: {String} id of the <form> this toggle controls (see snippets/buy-buttons.liquid).
  - block: {Object} optional, for shopify_attributes when rendered as a section block.
  - heading: {String} optional heading shown above the toggle.
  - aria_label: {String} optional radiogroup label override.
  - onetime_label: {String} optional label override.
  - subscribe_label: {String} optional label override.
  - badge_template: {String} optional badge copy, "{percent}" is replaced with the discount percent.
  - perk_1 / perk_2: {String} optional perk bullets shown under the subscribe option.
  - default_to_subscription: {Boolean} optional, preselects the subscribe option.

  Usage:
  {% render 'xula-subscription-toggle', product: product, product_form_id: product_form_id %}
{%- endcomment -%}

{%- liquid
  assign selling_plan_group = product.selling_plan_groups.first
  assign selling_plan = selling_plan_group.selling_plans.first
-%}

{%- if selling_plan_group != blank and selling_plan != blank -%}
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign current_allocation = blank
    for allocation in current_variant.selling_plan_allocations
      if allocation.selling_plan.id == selling_plan.id
        assign current_allocation = allocation
        break
      endif
    endfor

    assign discount_percent = 0
    assign plan_adjustment = selling_plan.price_adjustments.first
    if plan_adjustment.value_type == 'percentage' and plan_adjustment.value > 0
      assign discount_percent = plan_adjustment.value | round
    elsif current_allocation != blank and current_variant.price > 0
      assign discount_percent = current_variant.price | minus: current_allocation.price | times: 100.0 | divided_by: current_variant.price | round
    endif

    assign onetime_label = onetime_label | default: 'One-time purchase'
    assign subscribe_label = subscribe_label | default: 'Subscribe & Save'
    assign aria_label = aria_label | default: 'Purchase option'
    assign badge_template = badge_template | default: 'Save {percent}%'
    assign perk_1 = perk_1 | default: 'Free shipping on every subscription order'
    assign perk_2 = perk_2 | default: 'Skip, pause, or cancel anytime'
    assign badge_text = badge_template | replace: '{percent}', discount_percent
  -%}

  {%- capture variant_prices_json -%}
    {
      {%- for variant in product.variants -%}
        {%- liquid
          assign v_allocation = blank
          for allocation in variant.selling_plan_allocations
            if allocation.selling_plan.id == selling_plan.id
              assign v_allocation = allocation
              break
            endif
          endfor
        -%}
        "{{ variant.id }}": {
          "oneTimePrice": {{ variant.price | money | json }},
          "oneTimePriceRaw": {{ variant.price | json }}
          {%- if v_allocation != blank -%}
            ,
            "subscribeAvailable": true,
            "subscribePrice": {{ v_allocation.price | money | json }},
            "subscribePriceRaw": {{ v_allocation.price | json }},
            "sellingPlanId": {{ v_allocation.selling_plan.id | json }}
          {%- else -%}
            ,
            "subscribeAvailable": false,
            "subscribePrice": null,
            "subscribePriceRaw": null,
            "sellingPlanId": null
          {%- endif -%}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  {%- endcapture -%}

  <div
    class="xula-subscription-toggle"
    data-xula-subscription-toggle
    data-product-form-id="{{ product_form_id }}"
    data-default-plan="{% if default_to_subscription %}subscribe{% else %}onetime{% endif %}"
    data-badge-template="{{ badge_template | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <p class="xula-subscription-toggle__heading">{{ heading }}</p>
    {%- endif -%}

    <div class="xula-subscription-toggle__group" role="radiogroup" aria-label="{{ aria_label | escape }}">
      <button
        type="button"
        id="SubscriptionOption-onetime-{{ product_form_id }}"
        class="xula-subscription-toggle__option xula-subscription-toggle__option--onetime{% unless default_to_subscription %} is-active{% endunless %}"
        role="radio"
        aria-checked="{% if default_to_subscription %}false{% else %}true{% endif %}"
        tabindex="{% if default_to_subscription %}-1{% else %}0{% endif %}"
        data-xula-subscription-option="onetime"
      >
        <span class="xula-subscription-toggle__radio" aria-hidden="true"></span>
        <span class="xula-subscription-toggle__body">
          <span class="xula-subscription-toggle__label-row">
            <span class="xula-subscription-toggle__label">{{ onetime_label }}</span>
          </span>
        </span>
        <span class="xula-subscription-toggle__price-col">
          <span class="xula-subscription-toggle__price xula-type--code" data-xula-subscription-price="onetime">
            {{- current_variant.price | money -}}
          </span>
        </span>
      </button>

      <button
        type="button"
        id="SubscriptionOption-subscribe-{{ product_form_id }}"
        class="xula-subscription-toggle__option xula-subscription-toggle__option--subscribe{% if default_to_subscription %} is-active{% endif %}"
        role="radio"
        aria-checked="{% if default_to_subscription %}true{% else %}false{% endif %}"
        tabindex="{% if default_to_subscription %}0{% else %}-1{% endif %}"
        data-xula-subscription-option="subscribe"
        data-selling-plan-id="{{ selling_plan.id }}"
      >
        <span class="xula-subscription-toggle__radio" aria-hidden="true"></span>
        <span class="xula-subscription-toggle__body">
          <span class="xula-subscription-toggle__label-row">
            <span class="xula-subscription-toggle__label">{{ subscribe_label }}</span>
            <span
              class="xula-subscription-toggle__badge"
              data-xula-subscription-badge
              {% if discount_percent <= 0 %}hidden{% endif %}
            >
              {{- badge_text -}}
            </span>
          </span>
          {%- if selling_plan.name != blank -%}
            <span class="xula-subscription-toggle__frequency" data-xula-subscription-frequency>{{ selling_plan.name }}</span>
          {%- endif -%}
        </span>
        <span class="xula-subscription-toggle__price-col">
          <span
            class="xula-subscription-toggle__compare xula-type--code"
            data-xula-subscription-compare
            {% if current_allocation == blank %}hidden{% endif %}
          >
            {{- current_variant.price | money -}}
          </span>
          <span class="xula-subscription-toggle__price xula-type--code" data-xula-subscription-price="subscribe">
            {{- current_allocation.price | default: current_variant.price | money -}}
          </span>
        </span>
      </button>
    </div>

    <ul
      class="xula-subscription-toggle__perks" role="list" data-xula-subscription-perks
      {% unless default_to_subscription %}hidden{% endunless %}
    >
      {%- if perk_1 != blank -%}<li class="xula-subscription-toggle__perk">{{ perk_1 }}</li>{%- endif -%}
      {%- if perk_2 != blank -%}<li class="xula-subscription-toggle__perk">{{ perk_2 }}</li>{%- endif -%}
    </ul>

    <span class="visually-hidden" role="status" aria-live="polite" data-xula-subscription-announce></span>

    <input
      type="hidden"
      name="selling_plan"
      value="{% if default_to_subscription %}{{ selling_plan.id }}{% endif %}"
      form="{{ product_form_id }}"
      data-xula-subscription-input
    >

    <script type="application/json" data-xula-subscription-data>{{ variant_prices_json }}</script>
  </div>

  {{ 'xula-subscription-toggle.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'xula-subscription-toggle.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
