
{% comment %}
  One collection of the "Our Products" mega menu.
  Featured product: the block's pick, else the first available non-gift-card product
  in the collection's sort order (gift cards never represent a collection).
  Accessibility: plain links (disclosure navigation pattern, no role="menu").
  Performance: images are decorative (alt="") and only load when the menu opens
  (data-xula-src / data-xula-srcset, hydrated by xula-nav.js).
{% endcomment %}

{%- liquid
  assign product = featured_product
  if product == blank
    for candidate in collection.products limit: 12
      if candidate.gift_card? == false and candidate.available
        assign product = candidate
        break
      endif
    endfor
  endif
  if product == blank
    for candidate in collection.products limit: 12
      if candidate.gift_card? == false
        assign product = candidate
        break
      endif
    endfor
  endif

  assign media = image
  if media == blank and product != blank
    assign media = product.featured_media.preview_image
  endif
  if media == blank
    assign media = collection.featured_image
  endif

  assign badge_text = badge
  if badge_text == blank and auto_badge and product.selling_plan_groups.size > 0
    assign badge_text = subscription_label
    assign badge_style = 'gold'
  endif
  assign badge_style = badge_style | default: 'accent'

  assign is_current = false
  if collection.url == request.path
    assign is_current = true
  endif

  # Count excludes gift cards so the number matches what the collection represents.
  assign product_count = 0
  for candidate in collection.products limit: 50
    unless candidate.gift_card?
      assign product_count = product_count | plus: 1
    endunless
  endfor
  if product_count == 1
    assign count_sr = '1 product'
  else
    assign count_sr = product_count | append: ' products'
  endif
-%}

{%- case part -%}
  {%- when 'link' -%}
    <li class="xula-dropdown__collection" data-collection="{{ collection.handle }}" {% if block %}{{ block.shopify_attributes }}{% endif %}>
      <a
        href="{{ collection.url }}"
        class="xula-dropdown__collection-link{% if position == 1 %} is-active{% endif %}"
        data-xula-dropdown-item
        data-xula-preview-target="{{ position }}"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        <span class="xula-dropdown__collection-title">{{ collection.title | escape }}</span>
        <span class="xula-dropdown__collection-count xula-type--code">
          <span aria-hidden="true">{{ product_count }}</span>
          <span class="visually-hidden">({{ count_sr }})</span>
        </span>
        <svg class="xula-dropdown__collection-arrow" aria-hidden="true" focusable="false" viewBox="0 0 14 10" width="14" height="10">
          <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 5h12M9 1l4 4-4 4"/>
        </svg>
      </a>
    </li>

  {%- when 'preview' -%}
    {%- liquid
      if product != blank
        assign preview_url = product.url
      else
        assign preview_url = collection.url
      endif
    -%}
    <a
      href="{{ preview_url }}"
      class="xula-dropdown__feature{% if position == 1 %} is-active{% endif %}"
      data-collection="{{ collection.handle }}"
      data-xula-preview="{{ position }}"
      tabindex="-1"
      aria-hidden="true"
    >
      <span class="xula-dropdown__feature-media">
        {%- if media != blank -%}
          {%- capture feature_img -%}
          {{
            media
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
                decoding: 'async',
              sizes: '(min-width: 1200px) 560px, 50vw',
              widths: '400, 560, 800, 1120',
              alt: '',
              class: 'xula-dropdown__feature-image'
          }}
          {%- endcapture -%}
          {{ feature_img | replace: ' srcset="', ' data-xula-srcset="' | replace: ' src="', ' data-xula-src="' | replace: '<img ', '<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" ' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'xula-dropdown__feature-image xula-dropdown__feature-image--placeholder' }}
        {%- endif -%}
      </span>

      <span class="xula-dropdown__feature-body">
        {%- if badge_text != blank -%}
          <span class="xula-dropdown__badge xula-dropdown__badge--{{ badge_style }} xula-type--code">
            {{- badge_text | escape -}}
          </span>
        {%- endif -%}

        <span class="xula-dropdown__feature-collection xula-type--code">{{ collection.title | escape }}</span>

        {%- if product != blank -%}
          <span class="xula-dropdown__feature-title">{{ product.title | escape }}</span>
          <span class="xula-dropdown__price xula-type--code">
            {%- if product.price_varies -%}
              {%- assign price_min = product.price_min | money -%}
              {{- 'products.product.price.from_price_html' | t: price: price_min -}}
            {%- else -%}
              {{- product.price | money -}}
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}
              <s class="xula-dropdown__price-compare">{{ product.compare_at_price | money }}</s>
            {%- endif -%}
          </span>
        {%- elsif collection.description != blank -%}
          <span class="xula-dropdown__feature-text">{{ collection.description | strip_html | truncatewords: 18 }}</span>
        {%- endif -%}

        <span class="xula-dropdown__feature-cta">
          {{- cta_label | escape -}}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 14 10" width="14" height="10">
            <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 5h12M9 1l4 4-4 4"/>
          </svg>
        </span>
      </span>
    </a>

  {%- when 'mobile' -%}
    <li class="xula-dropdown__collection" data-collection="{{ collection.handle }}" {% if block %}{{ block.shopify_attributes }}{% endif %}>
      <a
        href="{{ collection.url }}"
        class="xula-dropdown__row"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        <span class="xula-dropdown__row-media" aria-hidden="true">
          {%- if media != blank -%}
            {%- capture row_img -%}
            {{
              media
              | image_url: width: 192
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                sizes: '64px',
                widths: '64, 128, 192',
                alt: '',
                class: 'xula-dropdown__row-image'
            }}
            {%- endcapture -%}
            {{ row_img | replace: ' srcset="', ' data-xula-srcset="' | replace: ' src="', ' data-xula-src="' | replace: '<img ', '<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" ' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'xula-dropdown__row-image xula-dropdown__feature-image--placeholder' }}
          {%- endif -%}
        </span>
        <span class="xula-dropdown__row-body">
          <span class="xula-dropdown__row-title">{{ collection.title | escape }}</span>
          {%- if product != blank -%}
            <span class="xula-dropdown__row-meta xula-type--code">{{ product.title | escape }}</span>
          {%- endif -%}
        </span>
        {%- if badge_text != blank -%}
          <span class="xula-dropdown__badge xula-dropdown__badge--{{ badge_style }} xula-type--code">
            {{- badge_text | escape -}}
          </span>
        {%- endif -%}
      </a>
    </li>
{%- endcase -%}
