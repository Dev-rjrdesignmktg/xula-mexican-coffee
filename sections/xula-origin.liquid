{{ 'xula-origin.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-origin.js' | asset_url }}" defer></script>

{% liquid
  assign origin_slides = section.blocks | where: 'type', 'image'
%}

<section class="xula-origin color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="xula-origin__grid">

      <!-- LEFT MEDIA -->
      <div class="xula-origin__media">
        <div class="xula-origin__slides" data-xula-origin-slides data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}">
          {% assign slide_index = 0 %}
          {% for image_block in origin_slides %}
            {% if image_block.settings.image != blank %}
              <div
                class="xula-origin__slide{% if slide_index == 0 %} is-active{% endif %}"
                {{ image_block.shopify_attributes }}
              >
                <img
                  src="{{ image_block.settings.image | image_url: width: 1400 }}"
                  srcset="{{ image_block.settings.image | image_url: width: 700 }} 700w, {{ image_block.settings.image | image_url: width: 1400 }} 1400w"
                  sizes="(min-width: 990px) 45vw, 90vw"
                  alt="{{ image_block.settings.image.alt | default: section.settings.heading | escape }}"
                  width="1400"
                  height="1600"
                  loading="{% if slide_index == 0 %}eager{% else %}lazy{% endif %}"
                >
              </div>
              {% assign slide_index = slide_index | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if slide_index == 0 and section.settings.image != blank %}
            <div class="xula-origin__slide is-active">
              <img
                src="{{ section.settings.image | image_url: width: 1400 }}"
                alt="{{ section.settings.heading | escape }}"
                width="1400"
                height="1600"
                loading="eager"
              >
            </div>
            {% assign slide_index = 1 %}
          {% endif %}
        </div>

        {% if section.settings.badge != blank %}
          <div class="xula-origin__badge">{{ section.settings.badge }}</div>
        {% endif %}

        {% if slide_index > 1 %}
          <div class="xula-origin__dots" role="tablist" aria-label="Gallery navigation">
            {% for i in (1..slide_index) %}
              <button
                type="button"
                class="xula-origin__dot{% if forloop.first %} is-active{% endif %}"
                data-slide-dot="{{ forloop.index0 }}"
                role="tab"
                aria-label="Show image {{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <span class="xula-origin__dot-fill"></span>
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT CONTENT -->
      <div class="xula-origin__content">

        {% if section.settings.eyebrow != blank %}
          <span class="xula-eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="xula-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="xula-text">
            {{ section.settings.text }}
          </p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="xula-origin__stats">
            {% for block in section.blocks %}
              {% if block.type == 'stat' %}
                <div class="xula-origin__stat" {{ block.shopify_attributes }}>
                  <span class="xula-origin__stat-top">
                    {% if block.settings.icon != 'none' %}
                      <span class="xula-origin__stat-icon">
                        {% render 'xula-stat-icon', icon: block.settings.icon %}
                      </span>
                    {% endif %}
                    <span class="xula-origin__stat-label">{{ block.settings.label }}</span>
                  </span>
                  <span class="xula-origin__stat-value">{{ block.settings.value }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="xula-btn">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xula Origin",
  "tag": "section",
  "class": "section-xula-origin",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used only if no slide images are added below."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "1,200masl"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Terroir"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grown in the highlands of Mexico."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "In the volcanic soil of Veracruz and Chiapas, small family farms nurture every cherry by hand, high above the clouds where the air is thin and the harvest is slow."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet the Farmers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "mountain", "label": "Mountain (altitude)" },
            { "value": "leaf", "label": "Leaf (variety)" },
            { "value": "calendar", "label": "Calendar (harvest)" },
            { "value": "home", "label": "Home (family farms)" },
            { "value": "bean", "label": "Coffee bean" },
            { "value": "drop", "label": "Drop (process)" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "1,200m"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Altitude"
        }
      ]
    },
    {
      "type": "image",
      "name": "Slide image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Origin",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "icon": "mountain",
            "value": "1,200m",
            "label": "Altitude"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "leaf",
            "value": "Bourbon",
            "label": "Variety"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "calendar",
            "value": "Nov – Feb",
            "label": "Harvest"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "home",
            "value": "40+",
            "label": "Family farms"
          }
        }
      ]
    }
  ]
}
{% endschema %}
