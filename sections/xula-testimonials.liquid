{{ 'xula-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-testimonials.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_id = 'xula-testimonials-heading-' | append: section.id
  assign summary_rating = section.settings.summary_rating | default: '4.9'
  assign total_blocks = section.blocks.size
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
-%}

<section
  id="XulaTestimonials-{{ section.id }}"
  class="xula-testimonials"
  data-xula-testimonials
  aria-labelledby="{{ heading_id }}"
  style="
    {%- if section.settings.background_color != blank -%}--xt-bg: {{ section.settings.background_color }};{%- endif -%}
    {%- if section.settings.text_color != blank -%}--xt-ink: {{ section.settings.text_color }};{%- endif -%}
    {%- if section.settings.accent_color != blank -%}--xt-gold: {{ section.settings.accent_color }};--xt-gold-deep: {{ section.settings.accent_color }};--xt-accent-fill: {{ section.settings.accent_color }};--xt-line: color-mix(in srgb, {{ section.settings.accent_color }} 22%, transparent);{%- endif -%}
    {%- if section.settings.badge_background_color != blank -%}--xt-badge-bg: {{ section.settings.badge_background_color }};{%- endif -%}
    {%- if section.settings.badge_text_color != blank -%}--xt-badge-ink: {{ section.settings.badge_text_color }};{%- endif -%}
    {%- if section.settings.arrow_color != blank -%}--xt-arrow: {{ section.settings.arrow_color }};--xt-arrow-border: color-mix(in srgb, {{ section.settings.arrow_color }} 45%, transparent);{%- endif -%}
    {%- if section.settings.arrow_hover_color != blank -%}--xt-arrow-hover: {{ section.settings.arrow_hover_color }};{%- endif -%}
    {%- if section.settings.arrow_hover_icon_color != blank -%}--xt-arrow-hover-ink: {{ section.settings.arrow_hover_icon_color }};{%- endif -%}
  "
>
  <div class="page-width">

    {%- comment -%} Editorial header: copy on the left, rating on the right {%- endcomment -%}
    <header class="xula-testimonials__header">
      <div class="xula-testimonials__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="xula-eyebrow xula-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="xula-heading xula-testimonials__heading" id="{{ heading_id }}">
          {{- section.settings.heading | escape -}}
        </h2>

        {%- if section.settings.text != blank -%}
          <p class="xula-testimonials__subtitle">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_summary -%}
        <div
          class="xula-testimonials__summary"
          role="img"
          aria-label="Calificación promedio de {{ summary_rating | escape }} sobre 5 estrellas, {{ section.settings.summary_count | escape }}"
        >
          <div class="xula-testimonials__summary-score" aria-hidden="true">
            <span class="xula-testimonials__summary-value">{{ summary_rating | escape }}</span>
            <span class="xula-testimonials__summary-max">/5</span>
          </div>
          <div class="xula-testimonials__summary-meta" aria-hidden="true">
            <span class="xula-testimonials__summary-stars">
              {%- for i in (1..5) -%}
                <svg class="xula-testimonials__star xula-testimonials__star--filled" viewBox="0 0 20 20">
                  <path d="m10 2.626-1.46 4.71c-.192.62-.743 1.041-1.365 1.041H2.453l3.82 2.91a1.55 1.55 0 0 1 .522 1.685l-1.46 4.71 3.821-2.911a1.38 1.38 0 0 1 1.688 0l3.82 2.91-1.459-4.71c-.192-.62.019-1.3.522-1.683l3.82-2.911h-4.722c-.622 0-1.173-.42-1.366-1.04z"/>
                </svg>
              {%- endfor -%}
            </span>
            <span class="xula-testimonials__summary-count">{{ section.settings.summary_count | escape }}</span>
          </div>
        </div>
      {%- endif -%}
    </header>

    {%- if total_blocks > 0 -%}
      <div
        class="xula-testimonials__spotlight"
        data-carousel
        data-autoplay="{% if section.settings.autoplay and total_blocks > 1 %}{{ autoplay_ms }}{% else %}0{% endif %}"
        role="region"
        aria-roledescription="carousel"
        aria-label="Reseñas de clientes"
        style="--xula-testimonials-duration: {{ autoplay_ms }}ms;"
      >

        {%- comment -%} Media column: rotating photo stack (decorative) + carousel controls {%- endcomment -%}
        <div class="xula-testimonials__media">
        <div class="xula-testimonials__stack" aria-hidden="true">
          {%- for block in section.blocks -%}
            <div class="xula-testimonials__stack-item" data-stack-item data-depth="{{ forloop.index0 }}">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(min-width: 1024px) 440px, (min-width: 900px) 360px, 280px',
                    alt: ''
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-testimonials__placeholder' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
          {%- if section.settings.badge_label != blank -%}
            <span class="xula-testimonials__stack-badge">
              <svg viewBox="0 0 20 20"><path d="M7.629 15.336 2.293 10l1.414-1.414 3.922 3.922 8.664-8.664 1.414 1.414z"/></svg>
              {{ section.settings.badge_label | escape }}
            </span>
          {%- endif -%}
        </div>

          {%- if total_blocks > 1 -%}
            <div class="xula-testimonials__nav">
              <div class="xula-testimonials__nav-row">
                {%- if section.settings.autoplay -%}
                  <button type="button" class="xula-testimonials__arrow xula-testimonials__toggle" data-toggle aria-label="Pausar reseñas">
                    <svg class="xula-testimonials__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    <svg class="xula-testimonials__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
                  </button>
                {%- endif -%}

                <div class="xula-testimonials__progress" aria-hidden="true">
                  {%- for block in section.blocks -%}
                    <span class="xula-testimonials__bar{% if forloop.first %} is-active{% endif %}" data-bar><span></span></span>
                  {%- endfor -%}
                </div>

                <span class="xula-testimonials__counter" aria-hidden="true">
                  <span data-current>01</span><span class="xula-testimonials__counter-sep">/</span>{{ total_blocks | prepend: '0' | slice: -2, 2 }}
                </span>
              </div>

              <div class="xula-testimonials__controls">
                <button type="button" class="xula-testimonials__arrow" data-dir="prev" aria-label="Reseña anterior">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="xula-testimonials__arrow" data-dir="next" aria-label="Siguiente reseña">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Quote panel {%- endcomment -%}
        <div
          class="xula-testimonials__panel{% if section.settings.panel_background_color != blank %} xula-testimonials__panel--boxed{% endif %}"
          style="
            {%- if section.settings.panel_background_color != blank -%}--xt-panel-bg: {{ section.settings.panel_background_color }};{%- endif -%}
            {%- if section.settings.panel_text_color != blank -%}--xt-ink: {{ section.settings.panel_text_color }};{%- endif -%}
            {%- if section.settings.panel_accent_color != blank -%}--xt-gold: {{ section.settings.panel_accent_color }};--xt-gold-deep: {{ section.settings.panel_accent_color }};--xt-line: color-mix(in srgb, {{ section.settings.panel_accent_color }} 25%, transparent);{%- endif -%}
          "
        >
          <svg class="xula-testimonials__mark" viewBox="0 0 48 36" aria-hidden="true">
            <path d="M0 36V22.2C0 9.9 6.4 2.5 19.2 0l2.1 4.5C14.6 6.6 11.2 10.6 10.9 16.5H20V36H0Zm27.9 0V22.2C27.9 9.9 34.3 2.5 47.1 0L48 4.5c-6.7 2.1-10.1 6.1-10.4 12H47V36H27.9Z"/>
          </svg>

          <div class="xula-testimonials__slides" aria-live="polite">
            {%- for block in section.blocks -%}
              {%- liquid
                assign customer_name = block.settings.customer_name | default: 'XULA Customer'
                assign initials = customer_name | split: ' '
                assign initial_a = initials.first | slice: 0
                assign initial_b = ''
                if initials.size > 1
                  assign initial_b = initials.last | slice: 0
                endif
                assign slide_label = customer_name | append: ', calificación de ' | append: block.settings.rating | append: ' sobre 5 estrellas'
              -%}

              <article
                class="xula-testimonials__slide{% if forloop.first %} is-active{% endif %}"
                data-slide
                role="group"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} de {{ total_blocks }}: {{ slide_label | escape }}"
                {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
                {{ block.shopify_attributes }}
              >
                <div class="xula-testimonials__stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <svg
                      class="xula-testimonials__star{% if i <= block.settings.rating %} xula-testimonials__star--filled{% endif %}"
                      viewBox="0 0 20 20"
                    >
                      <path d="m10 2.626-1.46 4.71c-.192.62-.743 1.041-1.365 1.041H2.453l3.82 2.91a1.55 1.55 0 0 1 .522 1.685l-1.46 4.71 3.821-2.911a1.38 1.38 0 0 1 1.688 0l3.82 2.91-1.459-4.71c-.192-.62.019-1.3.522-1.683l3.82-2.911h-4.722c-.622 0-1.173-.42-1.366-1.04z"/>
                    </svg>
                  {%- endfor -%}
                </div>

                {%- if block.settings.product_purchased != blank -%}
                  <span class="xula-testimonials__product">{{ block.settings.product_purchased | escape }}</span>
                {%- endif -%}

                {%- if block.settings.quote != blank -%}
                  <blockquote class="xula-testimonials__quote">
                    <p>{{ block.settings.quote | escape | newline_to_br }}</p>
                  </blockquote>
                {%- endif -%}

                <footer class="xula-testimonials__byline">
                  <span class="xula-testimonials__avatar" aria-hidden="true">{{ initial_a | append: initial_b | upcase }}</span>
                  <span class="xula-testimonials__who">
                    <span class="xula-testimonials__author">{{ customer_name | escape }}</span>
                    {%- if block.settings.verified -%}
                      <span class="xula-testimonials__verified">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629 15.336 2.293 10l1.414-1.414 3.922 3.922 8.664-8.664 1.414 1.414z"/></svg>
                        Verified buyer
                      </span>
                    {%- endif -%}
                  </span>
                </footer>
              </article>
            {%- endfor -%}
          </div>

        </div>

      </div>
    {%- endif -%}

    {%- if section.settings.show_guarantee -%}
      <div
        class="xula-testimonials__guarantee{% if section.settings.guarantee_background_color != blank %} xula-testimonials__guarantee--boxed{% endif %}"
        style="
          {%- if section.settings.guarantee_background_color != blank -%}--xt-guarantee-bg: {{ section.settings.guarantee_background_color }};{%- endif -%}
          {%- if section.settings.guarantee_text_color != blank -%}--xt-ink: {{ section.settings.guarantee_text_color }};{%- endif -%}
          {%- if section.settings.guarantee_icon_color != blank -%}--xt-seal: {{ section.settings.guarantee_icon_color }};{%- endif -%}
          {%- if section.settings.guarantee_border_color != blank -%}--xt-guarantee-border: {{ section.settings.guarantee_border_color }};{%- endif -%}
        "
      >
        <span class="xula-testimonials__seal" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2 3 6v6c0 5 3.8 9.4 9 10 5.2-.6 9-5 9-10V6l-9-4zm-1.2 13.6-3.4-3.4 1.4-1.4 2 2 4.8-4.8 1.4 1.4z"/></svg>
        </span>
        <div class="xula-testimonials__guarantee-copy">
          <strong>{{ section.settings.guarantee_heading | escape }}</strong>
          <span>{{ section.settings.guarantee_text | escape }}</span>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Xula Testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by Our Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The taste that keeps them coming back."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtitle",
      "default": "Thousands of cups poured, thousands of stories brewed. Here's what real XULA customers are saying."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#24170f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Change it if you pick a light background.",
      "default": "#f6ece0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Eyebrow, rating, stars, quote mark, progress bars, divider lines and seal. Leave empty for the XULA gold."
    },
    {
      "type": "header",
      "content": "Image badge",
      "info": "Pill on the photo. Leave the colours empty to keep the default gold badge."
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "info": "Leave empty to hide the badge.",
      "default": "Real customers"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background color"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color"
    },
    {
      "type": "header",
      "content": "Reviews panel",
      "info": "Box that holds the review. Leave empty for no box."
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "Panel background color"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel text color",
      "info": "Leave empty to use the section text color."
    },
    {
      "type": "color",
      "id": "panel_accent_color",
      "label": "Panel accent color",
      "info": "Overrides the accent inside the panel: quote mark, stars, \"Verified buyer\" and product tag. Pick a darker tone on a light panel."
    },
    {
      "type": "header",
      "content": "Arrows",
      "info": "Leave empty to keep the default colours."
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "info": "Icon and border. Also applies to the pause button."
    },
    {
      "type": "color",
      "id": "arrow_hover_color",
      "label": "Arrow hover fill"
    },
    {
      "type": "color",
      "id": "arrow_hover_icon_color",
      "label": "Arrow hover icon color"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per review",
      "min": 4,
      "max": 14,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "header",
      "content": "Ratings summary"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show ratings summary",
      "default": true
    },
    {
      "type": "text",
      "id": "summary_rating",
      "label": "Average rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "summary_count",
      "label": "Review count label",
      "default": "from 500+ verified reviews"
    },
    {
      "type": "header",
      "content": "Final trust badge (guarantee)"
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "Show guarantee seal",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee_heading",
      "label": "Guarantee heading",
      "default": "30-Day Happiness Guarantee"
    },
    {
      "type": "textarea",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Not the right roast for you? We'll make it right — refund or replace, no questions asked."
    },
    {
      "type": "color",
      "id": "guarantee_background_color",
      "label": "Guarantee background color",
      "default": "#3a2819",
      "info": "Leave empty for no box."
    },
    {
      "type": "color",
      "id": "guarantee_text_color",
      "label": "Guarantee text color",
      "info": "Leave empty to use the section text color."
    },
    {
      "type": "color",
      "id": "guarantee_icon_color",
      "label": "Guarantee seal color",
      "info": "Shield icon and seal rings. Leave empty to use the accent color."
    },
    {
      "type": "color",
      "id": "guarantee_border_color",
      "label": "Guarantee border color",
      "info": "Box outline (or the divider line when there is no box)."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (falls back to a placeholder image)"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The Dark Roast tastes like the coffee my abuela used to make. I order every month now."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Ana M."
        },
        {
          "type": "text",
          "id": "product_purchased",
          "label": "Product purchased",
          "default": "Dark Roast Specialty"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified purchase",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
