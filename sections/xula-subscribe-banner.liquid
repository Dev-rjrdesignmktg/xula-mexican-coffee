{{ 'xula-subscribe-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-subscribe-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_id = 'xula-subscribe-banner-heading-' | append: section.id
  assign heading_text = section.settings.heading | strip_html
  assign media_type = section.settings.media_type
  assign has_video = false
  if media_type == 'video' and section.settings.video != blank
    assign has_video = true
  endif
  assign poster_image = section.settings.video_poster | default: section.settings.image
  assign media_alt = section.settings.image_alt | default: heading_text | default: shop.name | append: ' — preparación de café XULA'

  assign steps = section.blocks | where: 'type', 'step'
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign style = section.settings.style | default: 'dark'
-%}

<section
  class="xula-subscribe-banner xula-subscribe-banner--{{ style }}"
  aria-labelledby="{{ heading_id }}"
  data-xula-subscribe-banner
>
  <div class="page-width">
    <div class="xula-subscribe-banner__frame">

      <div class="xula-subscribe-banner__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="xula-subscribe-banner__eyebrow xula-type--code">
            <span class="xula-subscribe-banner__eyebrow-rule" aria-hidden="true"></span>
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        <h2 class="xula-subscribe-banner__heading" id="{{ heading_id }}">{{ section.settings.heading }}</h2>

        {%- if section.settings.description != blank -%}
          <div class="xula-subscribe-banner__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if steps.size > 0 -%}
          <ol class="xula-subscribe-banner__steps" data-xula-subscribe-reveal>
            {%- for block in steps -%}
              <li class="xula-subscribe-banner__step" {{ block.shopify_attributes }}>
                <span class="xula-subscribe-banner__step-number xula-type--code" aria-hidden="true">
                  {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
                </span>
                <span class="xula-subscribe-banner__step-body">
                  {%- if block.settings.step_title != blank -%}
                    <span class="xula-subscribe-banner__step-title">{{ block.settings.step_title }}</span>
                  {%- endif -%}
                  {%- if block.settings.step_description != blank -%}
                    <span class="xula-subscribe-banner__step-description">{{ block.settings.step_description }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <div class="xula-subscribe-banner__actions">
            <a href="{{ section.settings.cta_link | default: '#' }}" class="xula-btn xula-subscribe-banner__cta">
              <span>{{ section.settings.cta_label }}</span>
              <svg class="xula-subscribe-banner__cta-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            {%- if section.settings.cta_note != blank -%}
              <p class="xula-subscribe-banner__cta-note xula-type--code">{{ section.settings.cta_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if benefits.size > 0 -%}
          <ul class="xula-subscribe-banner__benefits" role="list">
            {%- for block in benefits -%}
              <li class="xula-subscribe-banner__benefit" {{ block.shopify_attributes }}>
                <span class="xula-subscribe-banner__benefit-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'percent' -%}
                      <svg viewBox="0 0 20 20"><path d="M6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm8 8a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM14.7 5.3l-9.4 9.4-1.4-1.4 9.4-9.4z"/></svg>
                    {%- when 'shipping' -%}
                      <svg viewBox="0 0 24 24"><path d="M3 4h11v9H3zM14 8h4l3 3v2h-7zM6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm12 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>
                    {%- when 'pause' -%}
                      <svg viewBox="0 0 20 20"><path d="M6 4h3v12H6zM11 4h3v12h-3z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 20 20"><path d="M8.6 13.6 4.9 10l1.4-1.4 2.3 2.3 5-5L15 7.3z"/></svg>
                  {%- endcase -%}
                </span>
                <span class="xula-subscribe-banner__benefit-text">{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

      </div>

      <div class="xula-subscribe-banner__media">
        <div class="xula-subscribe-banner__media-frame">
          {%- if has_video -%}
            {%- if section.settings.disable_video_mobile and poster_image != blank -%}
              <img
                class="xula-subscribe-banner__poster xula-subscribe-banner__poster--mobile-only"
                src="{{ poster_image | image_url: width: 1200 }}"
                srcset="
                  {{ poster_image | image_url: width: 600 }} 600w,
                  {{ poster_image | image_url: width: 900 }} 900w,
                  {{ poster_image | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 990px) 45vw, 100vw"
                alt="{{ media_alt | escape }}"
                width="{{ poster_image.width }}"
                height="{{ poster_image.height }}"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
            <video
              class="xula-subscribe-banner__video{% if section.settings.disable_video_mobile %} xula-subscribe-banner__video--desktop-only{% endif %}"
              {%- if poster_image != blank %}
                poster="{{ poster_image | image_url: width: 1200 }}"
              {%- endif %}
              muted
              loop
              playsinline
              disablepictureinpicture
              preload="none"
              aria-hidden="true"
              tabindex="-1"
              data-xula-subscribe-video
            >
              {%- for source in section.settings.video.sources -%}
                <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif section.settings.image != blank -%}
            <img
              class="xula-subscribe-banner__image"
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="
                {{ section.settings.image | image_url: width: 480 }} 480w,
                {{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w
              "
              sizes="(min-width: 990px) 45vw, 100vw"
              alt="{{ media_alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              decoding="async"
            >
          {%- else -%}
            <span class="xula-subscribe-banner__placeholder" role="img" aria-label="{{ media_alt | escape }}">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-subscribe-banner__placeholder-svg' }}
            </span>
          {%- endif -%}
          <span class="xula-subscribe-banner__media-shade" aria-hidden="true"></span>
        </div>

        {%- if section.settings.badge_value != blank -%}
          <div class="xula-subscribe-banner__seal">
            <span class="xula-subscribe-banner__seal-value">{{ section.settings.badge_value }}</span>
            {%- if section.settings.badge_label != blank -%}
              <span class="xula-subscribe-banner__seal-label xula-type--code">{{ section.settings.badge_label }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": {{ heading_text | default: section.settings.eyebrow | json }},
    "description": {{ section.settings.description | strip_html | default: heading_text | json }},
    {%- if has_video -%}
      "image": [{{ poster_image | image_url: width: 1600 | prepend: 'https:' | json }}],
    {%- elsif section.settings.image != blank -%}
      "image": [{{ section.settings.image | image_url: width: 1600 | prepend: 'https:' | json }}],
    {%- endif -%}
    "step": [
      {%- for block in steps -%}
        {
          "@type": "HowToStep",
          "position": {{ forloop.index }},
          "name": {{ block.settings.step_title | strip_html | json }},
          "text": {{ block.settings.step_description | strip_html | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Xula Subscribe Banner",
  "tag": "section",
  "class": "section xula-subscribe-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo del panel",
      "options": [
        { "value": "dark", "label": "Espresso (oscuro)" },
        { "value": "light", "label": "Crema (claro)" }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "¡Suscríbete y ahorra!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tu ritual de café, siempre fresco"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Recibe tu café de especialidad recién tostado en la puerta de tu casa, en la frecuencia que elijas. Ajusta, pausa o cancela cuando quieras.</p>"
    },
    {
      "type": "header",
      "content": "Llamado a la acción"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "Comenzar mi suscripción"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Nota bajo el botón",
      "default": "Sin compromiso — pausa o edita cuando quieras"
    },
    {
      "type": "header",
      "content": "Sello de ahorro"
    },
    {
      "type": "text",
      "id": "badge_value",
      "label": "Valor destacado",
      "info": "Se muestra como sello sobre la imagen. Déjalo vacío para ocultarlo.",
      "default": "15%"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Texto del sello",
      "default": "de ahorro en cada envío"
    },
    {
      "type": "header",
      "content": "Medio: imagen o video"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Tipo de medio",
      "options": [
        { "value": "image", "label": "Imagen" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "info": "Describe la escena para lectores de pantalla y SEO. Si se deja vacío, se usa el título de la sección."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Imagen de respaldo (poster / móvil)"
    },
    {
      "type": "checkbox",
      "id": "disable_video_mobile",
      "label": "Desactivar video en móvil",
      "info": "Recomendado para mejorar la velocidad de carga en móvil.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso numerado",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Título del paso",
          "default": "Elige tu café y frecuencia"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "Descripción del paso",
          "default": "Selecciona tu tueste favorito y con qué frecuencia quieres recibirlo."
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Viñeta de confianza",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "percent", "label": "Ahorro" },
            { "value": "shipping", "label": "Envío" },
            { "value": "pause", "label": "Pausar / editar" },
            { "value": "check", "label": "Check" }
          ],
          "default": "percent"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Ahorra 15% en cada envío"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Subscribe Banner",
      "blocks": [
        { "type": "step", "settings": { "step_title": "Elige tu café y frecuencia", "step_description": "Selecciona tu tueste favorito y con qué frecuencia quieres recibirlo." } },
        { "type": "step", "settings": { "step_title": "Nosotros tostamos y enviamos", "step_description": "Tostamos en pequeños lotes y lo enviamos fresco a tu puerta." } },
        { "type": "step", "settings": { "step_title": "Disfruta y ajusta cuando quieras", "step_description": "Pausa, cambia el tueste o cancela en cualquier momento, sin compromiso." } },
        { "type": "benefit", "settings": { "icon": "percent", "text": "Ahorra 15% en cada envío" } },
        { "type": "benefit", "settings": { "icon": "shipping", "text": "Envío express incluido" } },
        { "type": "benefit", "settings": { "icon": "pause", "text": "Pausa o edita cuando quieras" } }
      ]
    }
  ]
}
{% endschema %}
