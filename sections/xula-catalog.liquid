{{ 'xula-catalog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-catalog.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign catalog_id = 'XulaCatalog-' | append: section.id
  assign ld_ids = ''
  assign ld_products = ''
  assign ld_count = 0
-%}

<section
  class="xula-catalog"
  id="{{ catalog_id }}"
  data-xula-catalog
  aria-labelledby="{{ catalog_id }}-heading"
>
  <div class="page-width">

    <div class="xula-catalog__intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="xula-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="{{ catalog_id }}-heading" class="xula-heading xula-catalog__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="xula-catalog__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div
        class="xula-catalog__tabs"
        role="tablist"
        aria-label="{{ section.settings.heading | default: 'Product categories' | escape }}"
        data-xula-catalog-tablist
      >
        {%- for block in section.blocks -%}
          {%- assign tab_label = block.settings.label | default: block.settings.collection.title -%}
          <button
            type="button"
            id="{{ catalog_id }}-tab-{{ forloop.index0 }}"
            class="xula-catalog__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="{{ catalog_id }}-panel-{{ forloop.index0 }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-xula-catalog-tab
            {{ block.shopify_attributes }}
          >
            {{ tab_label }}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign products_limit = block.settings.products_to_show | default: 12 -%}

        <div
          id="{{ catalog_id }}-panel-{{ forloop.index0 }}"
          class="xula-catalog__panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          aria-labelledby="{{ catalog_id }}-tab-{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
          tabindex="0"
          data-xula-catalog-panel
        >
          {%- if collection != blank and collection.products.size > 0 -%}
            <div class="xula-catalog__carousel" data-xula-carousel>
              <button
                type="button"
                class="xula-catalog__nav xula-catalog__nav--prev"
                data-xula-carousel-prev
                aria-label="Previous products"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div class="xula-catalog__viewport">
                <ul class="xula-catalog__track" data-xula-carousel-track tabindex="-1">
                {%- for product in collection.products limit: products_limit -%}
                  {%- assign featured_image = product.featured_image -%}
                  {%- assign hover_image = product.images[1] -%}
                  {%- assign variant = product.selected_or_first_available_variant -%}
                  {%- assign tasting_notes = product.metafields.custom.tasting_notes -%}
                  {%- assign roast_level = product.metafields.custom.roast_level -%}
                  {%- assign presentations = product.metafields.custom.presentations -%}

                  {%- comment -%} collect unique products for JSON-LD {%- endcomment -%}
                  {%- assign pid = product.id | append: ',' -%}
                  {%- unless ld_ids contains pid -%}
                    {%- assign ld_ids = ld_ids | append: pid -%}
                    {%- assign ld_count = ld_count | plus: 1 -%}
                    {%- capture ld_item -%}
                      {
                        "@type": "ListItem",
                        "position": {{ ld_count }},
                        "item": {
                          "@type": "Product",
                          "name": {{ product.title | json }},
                          "url": {{ shop.url | append: product.url | json }},
                          "image": {{ featured_image | image_url: width: 800 | prepend: 'https:' | json }},
                          "sku": {{ variant.sku | json }},
                          "offers": {
                            "@type": "Offer",
                            "priceCurrency": {{ cart.currency.iso_code | json }},
                            "price": {{ variant.price | divided_by: 100.0 | json }},
                            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
                            "url": {{ shop.url | append: product.url | json }}
                          }
                        }
                      }
                    {%- endcapture -%}
                    {%- if ld_count > 1 -%}
                      {%- assign ld_products = ld_products | append: '|XULA_LD_SPLIT|' -%}
                    {%- endif -%}
                    {%- assign ld_products = ld_products | append: ld_item -%}
                  {%- endunless -%}

                  <li class="xula-catalog__slide" data-xula-carousel-slide>
                    <article class="xula-catalog__card" data-xula-product-card>

                      <a href="{{ product.url }}" class="xula-catalog__media" tabindex="-1">
                        {%- if featured_image -%}
                          <img
                            class="xula-catalog__image xula-catalog__image--primary"
                            src="{{ featured_image | image_url: width: 600 }}"
                            srcset="
                              {{ featured_image | image_url: width: 400 }} 400w,
                              {{ featured_image | image_url: width: 600 }} 600w,
                              {{ featured_image | image_url: width: 800 }} 800w"
                            sizes="(min-width: 990px) 320px, 60vw"
                            alt="{{ featured_image.alt | default: product.title | escape }}"
                            width="{{ featured_image.width }}"
                            height="{{ featured_image.height }}"
                            loading="lazy"
                            decoding="async"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'xula-catalog__image xula-catalog__image--primary xula-catalog__image--placeholder' }}
                        {%- endif -%}

                        {%- if hover_image -%}
                          <img
                            class="xula-catalog__image xula-catalog__image--secondary"
                            src="{{ hover_image | image_url: width: 600 }}"
                            alt=""
                            width="{{ hover_image.width }}"
                            height="{{ hover_image.height }}"
                            loading="lazy"
                            decoding="async"
                            aria-hidden="true"
                          >
                        {%- endif -%}

                        {%- if product.compare_at_price > product.price -%}
                          <span class="xula-catalog__badge">Sale</span>
                        {%- endif -%}
                      </a>

                      <button
                        type="button"
                        class="xula-catalog__quick-add"
                        data-xula-quick-add
                        aria-expanded="false"
                        aria-controls="{{ catalog_id }}-glass-{{ product.id }}"
                        aria-label="{{ 'Quick add' | append: ' - ' | append: product.title | escape }}"
                      >
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                          <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span>Quick add</span>
                      </button>

                      <div
                        class="xula-catalog__glass"
                        id="{{ catalog_id }}-glass-{{ product.id }}"
                        data-xula-glass
                        aria-hidden="true"
                      >
                        <div class="xula-catalog__glass-inner">
                          <p class="xula-catalog__glass-title">{{ product.title }}</p>

                          <dl class="xula-catalog__glass-specs">
                            {%- if roast_level != blank -%}
                              <div class="xula-catalog__glass-spec">
                                <dt>Roast level</dt>
                                <dd>{{ roast_level }}</dd>
                              </div>
                            {%- endif -%}

                            {%- if tasting_notes != blank -%}
                              <div class="xula-catalog__glass-spec">
                                <dt>Tasting notes</dt>
                                <dd>
                                  {%- if tasting_notes.type == 'list.single_line_text_field' -%}
                                    {{ tasting_notes.value | join: ', ' }}
                                  {%- else -%}
                                    {{ tasting_notes }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}

                            {%- if presentations != blank -%}
                              <div class="xula-catalog__glass-spec">
                                <dt>Presentations</dt>
                                <dd>
                                  {%- if presentations.type == 'list.single_line_text_field' -%}
                                    {{ presentations.value | join: ', ' }}
                                  {%- else -%}
                                    {{ presentations }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- elsif product.variants.size > 1 -%}
                              <div class="xula-catalog__glass-spec">
                                <dt>Presentations</dt>
                                <dd>{{ product.options_with_values.first.values | join: ', ' }}</dd>
                              </div>
                            {%- endif -%}
                          </dl>

                          <div class="xula-catalog__glass-price">
                            {{ variant.price | money }}
                            {%- if product.compare_at_price > variant.price -%}
                              <s class="xula-catalog__glass-compare">{{ product.compare_at_price | money }}</s>
                            {%- endif -%}
                          </div>

                          <form
                            method="post"
                            action="{{ routes.cart_add_url }}"
                            data-xula-add-form
                            class="xula-catalog__glass-form"
                          >
                            <input type="hidden" name="id" value="{{ variant.id }}" data-xula-variant-id>
                            <input type="hidden" name="quantity" value="1">

                            {%- if product.variants.size > 1 -%}
                              <label class="xula-catalog__glass-select-label" for="{{ catalog_id }}-select-{{ product.id }}">
                                Choose option
                              </label>
                              <select
                                id="{{ catalog_id }}-select-{{ product.id }}"
                                class="xula-catalog__glass-select"
                                data-xula-variant-select
                              >
                                {%- for v in product.variants -%}
                                  <option value="{{ v.id }}" {% if v.id == variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                                    {{ v.title }} — {{ v.price | money }}{% unless v.available %} (Sold out){% endunless %}
                                  </option>
                                {%- endfor -%}
                              </select>
                            {%- endif -%}

                            <button
                              type="submit"
                              class="xula-btn xula-catalog__glass-submit"
                              data-xula-add-submit
                              {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                            >
                              <span class="xula-catalog__glass-submit-text">
                                {%- if variant.available -%}
                                  Add to cart
                                {%- else -%}
                                  Sold out
                                {%- endif -%}
                              </span>
                            </button>

                            <p class="xula-catalog__glass-message" data-xula-add-message role="status" aria-live="polite"></p>
                          </form>
                        </div>
                      </div>

                      <div class="xula-catalog__info">
                        <h3 class="xula-catalog__title">
                          <a href="{{ product.url }}">{{ product.title }}</a>
                        </h3>
                        {%- if product.vendor != blank -%}
                          <p class="xula-catalog__vendor">{{ product.vendor }}</p>
                        {%- endif -%}
                        <div class="xula-catalog__price">
                          <span class="xula-catalog__price-current">{{ variant.price | money }}</span>
                          {%- if product.compare_at_price > variant.price -%}
                            <s class="xula-catalog__price-compare">{{ product.compare_at_price | money }}</s>
                          {%- endif -%}
                        </div>
                      </div>
                    </article>
                  </li>
                {%- endfor -%}
                </ul>
              </div>

              <button
                type="button"
                class="xula-catalog__nav xula-catalog__nav--next"
                data-xula-carousel-next
                aria-label="Next products"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            <div class="xula-catalog__dots" data-xula-carousel-dots role="tablist" aria-label="Carousel pagination"></div>
          {%- else -%}
            <p class="xula-catalog__empty">
              Select a collection to display products in this category.
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{%- if ld_products != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ section.settings.heading | default: shop.name | json }},
      "itemListElement": [{{ ld_products | split: '|XULA_LD_SPLIT|' | join: ',' }}]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Xula Catalog Tabs",
  "tag": "section",
  "class": "section-xula-catalog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our catalog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your XULA ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Coffee, chocolate, and artisan baked goods, organized by category."
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category Tab",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Catalog Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": { "label": "Coffee" }
        },
        {
          "type": "tab",
          "settings": { "label": "Chocolate" }
        },
        {
          "type": "tab",
          "settings": { "label": "Baked Goods" }
        }
      ]
    }
  ]
}
{% endschema %}
