{{ 'xula-journey.css' | asset_url | stylesheet_tag }}
{%- if section.blocks.size > 1 -%}
  <script src="{{ 'xula-journey.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign heading_id = 'XulaJourneyHeading-' | append: section.id
  assign image_sizes = '(min-width: 1200px) 560px, (min-width: 990px) calc(50vw - 60px), calc(100vw - 30px)'
-%}

<section
  class="xula-journey"
  {% if section.settings.eyebrow != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
  style="
    --xula-journey-steps: {{ section.blocks.size }};
    --xula-journey-bg: {{ section.settings.background_color }};
    --xula-journey-text: {{ section.settings.text_color }};
    --xula-journey-eyebrow: {{ section.settings.eyebrow_color }};
    --xula-journey-step: {{ section.settings.step_color }};
  "
>
  <div class="page-width">
    <div class="xula-journey__grid">
      {%- comment -%} Left column: sticky copy on desktop {%- endcomment -%}
      <div class="xula-journey__content">
        {%- if section.settings.eyebrow != blank -%}
          <h2 id="{{ heading_id }}" class="xula-eyebrow journey--eyebrow">
            {{- section.settings.eyebrow | escape -}}
          </h2>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <div
            class="xula-journey__copy{% if forloop.first %} is-active{% endif %}"
            data-copy="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <span class="xula-journey__num" aria-hidden="true">
              {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>
            {%- if block.settings.step_label != blank -%}
              <p class="xula-journey__step">{{ block.settings.step_label | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="xula-heading journey--heading">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="xula-journey__text">{{ block.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.blocks.size > 1 -%}
          <div class="xula-journey__progress" aria-hidden="true">
            <span class="xula-journey__counter">
              <span class="xula-journey__counter-current">01</span>
              <span class="xula-journey__counter-total">/ {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
            </span>
            <span class="xula-journey__track"><span class="xula-journey__bar"></span></span>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right column: scrolling images {%- endcomment -%}
      <div class="xula-journey__media">
        {%- for block in section.blocks -%}
          <div
            class="xula-journey__item{% if forloop.first %} is-active{% endif %}"
            data-step="{{ forloop.index0 }}"
          >
            {%- if block.settings.image != blank -%}
              {%- assign image_alt = block.settings.image.alt | default: block.settings.title -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: image_sizes,
                  loading: 'lazy',
                  decoding: 'async',
                  alt: image_alt
              }}
            {%- elsif request.design_mode -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-journey__placeholder' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xula Journey",
  "class": "section-xula-journey",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Used as the section heading for search engines and screen readers.",
      "default": "The journey of Xula"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#439135"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "step_color",
      "label": "Step Color",
      "info": "Applies to the large number and the step label.",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Set the image alt text in Files for better SEO. Falls back to the title."
        },
        {
          "type": "text",
          "id": "step_label",
          "label": "Step Label",
          "default": "Step 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "From Bean to Ritual"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We source premium Mexican coffee directly from high-altitude farms."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Journey",
      "settings": {
        "eyebrow": "The journey of Xula"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_label": "Step 1",
            "title": "Source",
            "text": "Premium coffee beans selected directly from origin."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "Step 2",
            "title": "Craft",
            "text": "Roasted with precision to preserve flavor complexity."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "Step 3",
            "title": "Ritual",
            "text": "A premium experience rooted in culture and craft."
          }
        }
      ]
    }
  ]
}
{% endschema %}
