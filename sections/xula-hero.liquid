{{ "xula-hero.css" | asset_url | stylesheet_tag }}
<script src='{{ "xula-hero.js" | asset_url }}' defer></script>

{%- liquid
  assign heading = section.settings.heading
  assign heading_parts = heading | split: '. '
-%}

<section class="xula-hero">
  <div class="xula-hero__glow" aria-hidden="true"></div>

  <div class="page-width">
    <div class="xula-hero__grid">

      <!-- LEFT CONTENT -->
      <div class="xula-hero__content">

        {% if section.settings.eyebrow != blank %}
          <span class="xula-eyebrow xula-hero__eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}

        {% if heading != blank %}
          <h1 class="xula-hero__heading">
            {%- if heading_parts.size > 1 -%}
              {%- assign heading_rest = heading_parts | slice: 1, heading_parts.size | join: '. ' -%}
              <span class="xula-hero__heading-line">{{ heading_parts.first }}.</span>
              <span class="xula-hero__heading-line xula-hero__heading-accent">{{ heading_rest }}</span>
            {%- else -%}
              {{ heading }}
            {%- endif -%}
          </h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="xula-text xula-hero__text">
            {{ section.settings.text }}
          </p>
        {% endif %}

        <div class="xula-hero__actions">
          {% if section.settings.primary_label != blank %}
            <a href="{{ section.settings.primary_link }}" class="xula-btn xula-hero__btn">
              <span>{{ section.settings.primary_label }}</span>
            </a>
          {% endif %}

          {% if section.settings.secondary_label != blank %}
            <a href="{{ section.settings.secondary_link }}" class="xula-btn--secondary xula-hero__link">
              <span>{{ section.settings.secondary_label }}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>

        <ul class="xula-hero__meta" role="list">
          <li>Single Origin</li>
          <li>Small Batch</li>
          <li>Mexican Highlands</li>
        </ul>

      </div>

      <!-- RIGHT MEDIA -->
      <div class="xula-hero__media">

        <div class="xula-hero__image-stack">

          {% if section.settings.image_1 != blank %}
            <img
              class="xula-hero__img xula-hero__img--1 is-active"
              src="{{ section.settings.image_1 | image_url: width: 1600 }}"
              srcset="
                {{ section.settings.image_1 | image_url: width: 750 }} 750w,
                {{ section.settings.image_1 | image_url: width: 1100 }} 1100w,
                {{ section.settings.image_1 | image_url: width: 1600 }} 1600w
              "
              sizes="(min-width: 990px) 55vw, 100vw"
              alt="{{ section.settings.image_1.alt | default: 'Xula Coffee lifestyle' | escape }}"
              loading="eager"
              fetchpriority="high"
              width="{{ section.settings.image_1.width }}"
              height="{{ section.settings.image_1.height }}"
            >
          {% endif %}

          {% if section.settings.image_2 != blank %}
            <img
              class="xula-hero__img xula-hero__img--2"
              src="{{ section.settings.image_2 | image_url: width: 1600 }}"
              srcset="
                {{ section.settings.image_2 | image_url: width: 750 }} 750w,
                {{ section.settings.image_2 | image_url: width: 1100 }} 1100w,
                {{ section.settings.image_2 | image_url: width: 1600 }} 1600w
              "
              sizes="(min-width: 990px) 55vw, 100vw"
              alt="{{ section.settings.image_2.alt | default: 'Xula Coffee product detail' | escape }}"
              loading="eager"
              width="{{ section.settings.image_2.width }}"
              height="{{ section.settings.image_2.height }}"
            >
          {% endif %}

        </div>

        {% if section.settings.badge != blank %}
          <div class="xula-hero__badge">
            <span class="xula-hero__badge-dot" aria-hidden="true"></span>
            {{ section.settings.badge }}
          </div>
        {% endif %}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xula Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Authentic Mexican Coffee"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted in Mexico. Brewed for Ritual."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Small-batch roasted coffee rooted in Mexican tradition, designed for slow mornings and rich flavor."
    },
    {
    "type": "image_picker",
    "id": "image_1",
    "label": "Hero Image 1 (Lifestyle)"
    },
    {
    "type": "image_picker",
    "id": "image_2",
    "label": "Hero Image 2 (Product focus)"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button",
      "default": "Shop Coffee"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Fresh Roast"
    }
  ],
  "presets": [
    {
      "name": "Xula Hero"
    }
  ]
}
{% endschema %}