{{ 'xula-blog-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-blog-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign blog_grid_id = 'XulaBlogGrid-' | append: section.id
  assign blog = section.settings.blog | default: blog
  assign articles_to_show = section.settings.articles_to_show | default: 8
  assign initial_visible = section.settings.initial_visible | default: 4
  assign heading = section.settings.heading | default: 'Blog'
  assign enable_filters = section.settings.enable_filters
  assign enable_load_more = section.settings.enable_load_more
  assign ld_articles = ''
  assign ld_count = 0
  assign category_string = ''

  if blog != blank
    assign articles = blog.articles | slice: 0, articles_to_show
  else
    assign articles = empty
  endif

  for article in articles
    assign cat = article.tags.first
    if cat != blank
      assign category_string = category_string | append: cat | append: '|XULA_CAT_SPLIT|'
    endif
  endfor
  assign categories = category_string | split: '|XULA_CAT_SPLIT|' | uniq
-%}

<section
  class="xula-blog-grid"
  id="{{ blog_grid_id }}"
  aria-labelledby="{{ blog_grid_id }}-heading"
>
  <div class="page-width">

    {%- if section.settings.show_breadcrumb -%}
      <nav class="xula-blog-grid__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label | default: 'Home' }}</a>
        <span class="xula-blog-grid__breadcrumb-sep" aria-hidden="true">&mdash;</span>
        <span aria-current="page">{{ heading }}</span>
      </nav>
    {%- endif -%}

    <div class="xula-blog-grid__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="xula-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="xula-blog-grid__heading" id="{{ blog_grid_id }}-heading">{{ heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="xula-blog-grid__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if enable_filters and categories.size > 1 -%}
      <div class="xula-blog-grid__filters" role="group" aria-label="Filter articles by category" data-blog-grid-filters>
        <button type="button" class="xula-blog-grid__filter is-active" data-blog-grid-filter="all" aria-pressed="true">
          {{ section.settings.all_filter_label | default: 'All' }}
        </button>
        {%- for cat in categories -%}
          <button type="button" class="xula-blog-grid__filter" data-blog-grid-filter="{{ cat | handle }}" aria-pressed="false">
            {{ cat }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if articles.size > 0 -%}
      <ul class="xula-blog-grid__grid" data-blog-grid-grid data-initial-visible="{{ initial_visible }}" role="list">
        {%- for article in articles -%}
          {%- assign category = article.tags.first -%}
          {%- assign article_image = article.image -%}
          {%- assign img_alt = article_image.alt | default: article.title | escape -%}
          {%- assign pattern_index = forloop.index | modulo: 4 -%}
          {%- case pattern_index -%}
            {%- when 1 or 0 -%}
              {%- assign size_modifier = 'large' -%}
            {%- else -%}
              {%- assign size_modifier = 'small' -%}
          {%- endcase -%}

          {%- comment -%} collect articles for JSON-LD {%- endcomment -%}
          {%- assign ld_count = ld_count | plus: 1 -%}
          {%- capture ld_item -%}
            {
              "@type": "BlogPosting",
              "headline": {{ article.title | json }},
              "url": {{ shop.url | append: article.url | json }},
              "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
              "image": {{ article_image | image_url: width: 800 | prepend: 'https:' | json }},
              "author": {
                "@type": "Person",
                "name": {{ article.author | json }}
              }
            }
          {%- endcapture -%}
          {%- if ld_count > 1 -%}
            {%- assign ld_articles = ld_articles | append: '|XULA_LD_SPLIT|' -%}
          {%- endif -%}
          {%- assign ld_articles = ld_articles | append: ld_item -%}

          <li
            class="xula-blog-grid__item xula-blog-grid__item--{{ size_modifier }}"
            data-blog-grid-item
            data-blog-grid-index="{{ forloop.index0 }}"
            data-blog-grid-category="{{ category | handle }}"
          >
            <article class="xula-blog-grid__card">
              <a
                href="{{ article.url }}"
                class="xula-blog-grid__link"
                aria-labelledby="{{ blog_grid_id }}-title-{{ forloop.index }}"
              >
                <div class="xula-blog-grid__media">
                  {%- if article_image -%}
                    <img
                      class="xula-blog-grid__image"
                      src="{{ article_image | image_url: width: 900 }}"
                      srcset="
                        {{ article_image | image_url: width: 480 }} 480w,
                        {{ article_image | image_url: width: 700 }} 700w,
                        {{ article_image | image_url: width: 900 }} 900w,
                        {{ article_image | image_url: width: 1300 }} 1300w"
                      sizes="(min-width: 990px) {% if size_modifier == 'large' %}55vw{% else %}30vw{% endif %}, 100vw"
                      alt="{{ img_alt }}"
                      width="{{ article_image.width }}"
                      height="{{ article_image.height }}"
                      loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}"
                      decoding="async"
                    >
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-blog-grid__image xula-blog-grid__image--placeholder' }}
                  {%- endif -%}

                  <span class="xula-blog-grid__scrim" aria-hidden="true"></span>

                  {%- if section.settings.show_category and category != blank -%}
                    <span class="xula-blog-grid__tag">{{ category }}</span>
                  {%- endif -%}

                  <div class="xula-blog-grid__caption">
                    <h3 class="xula-blog-grid__title" id="{{ blog_grid_id }}-title-{{ forloop.index }}">
                      <span class="xula-blog-grid__title-text">{{ article.title }}</span>
                      <svg class="xula-blog-grid__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                        <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </h3>

                    <p class="xula-blog-grid__meta">
                      {%- if section.settings.show_author and article.author != blank -%}
                        <span class="xula-blog-grid__author">by {{ article.author }}</span>
                      {%- endif -%}
                      {%- if section.settings.show_date -%}
                        <time class="xula-blog-grid__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                          {{ article.published_at | date: '%B %d, %Y' }}
                        </time>
                      {%- endif -%}
                    </p>
                  </div>
                </div>
              </a>
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if enable_load_more and articles.size > initial_visible -%}
        <div class="xula-blog-grid__load-more-wrap" data-blog-grid-load-more-wrap>
          <button
            type="button"
            class="xula-btn--secondary xula-blog-grid__load-more"
            data-blog-grid-load-more
            aria-controls="{{ blog_grid_id }}"
            aria-expanded="false"
          >
            <span>{{ section.settings.load_more_label | default: 'Load More' }}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M12 5v14M5 12l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="xula-blog-grid__empty">Select a blog with published articles to display them here.</p>
    {%- endif -%}

  </div>
</section>

{%- if ld_articles != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": {{ blog.title | default: shop.name | json }},
      "blogPost": [{{ ld_articles | split: '|XULA_LD_SPLIT|' | join: ',' }}]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Xula Blog Grid",
  "tag": "section",
  "class": "section-xula-blog-grid",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_label",
      "label": "Breadcrumb home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blog"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Leave blank to automatically use the current blog when this section is placed on a blog page."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category tag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "header",
      "content": "Filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Enable category filters",
      "info": "Categories are built from each article's first tag.",
      "default": true
    },
    {
      "type": "text",
      "id": "all_filter_label",
      "label": "\"All\" filter label",
      "default": "All"
    },
    {
      "type": "header",
      "content": "Load more"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "Enable \"Load More\" button",
      "default": true
    },
    {
      "type": "range",
      "id": "initial_visible",
      "label": "Articles visible before \"Load More\"",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "\"Load More\" label",
      "default": "Load More"
    }
  ],
  "presets": [
    {
      "name": "Xula Blog Grid"
    }
  ]
}
{% endschema %}
