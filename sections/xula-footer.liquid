{{ 'xula-footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-footer.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign heading_id = 'xula-footer-heading-' | append: section.id
  assign contact_email = section.settings.contact_email | default: shop.email

  assign has_social = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
    assign has_social = true
  endif

  assign show_country = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign show_country = true
  endif

  assign show_language = false
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign show_language = true
  endif

  assign show_localization = false
  if show_country or show_language
    assign show_localization = true
  endif
%}

{% if section.settings.show_structured_data %}
  {% capture social_raw %}{{ settings.social_instagram_link }}|{{ settings.social_facebook_link }}|{{ settings.social_tiktok_link }}|{{ settings.social_youtube_link }}|{{ settings.social_twitter_link }}|{{ settings.social_pinterest_link }}|{{ settings.social_snapchat_link }}|{{ settings.social_tumblr_link }}|{{ settings.social_vimeo_link }}{% endcapture %}
  {% assign social_links = social_raw | split: '|' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }}
      {% if settings.logo != blank %}
        ,"logo": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }}
      {% endif %}
      {% if contact_email != blank %}
        ,"contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "email": {{ contact_email | json }}
          {% if section.settings.contact_phone != blank %}
            ,"telephone": {{ section.settings.contact_phone | json }}
          {% endif %}
        }
      {% endif %}
      ,"sameAs": [
        {% assign is_first_social = true %}
        {% for link in social_links %}
          {% if link != blank %}
            {% unless is_first_social %},{% endunless %}
            {{ link | json }}
            {% assign is_first_social = false %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

<footer class="xula-footer" id="xula-footer-{{ section.id }}" aria-labelledby="{{ heading_id }}">
  <p class="visually-hidden" id="{{ heading_id }}">{{ section.settings.brand_heading | default: shop.name }}</p>

  <div class="xula-footer__container page-width">

    <div class="xula-footer__top">
      <div class="xula-footer__brand">
        {% if section.settings.logo != blank %}
          {% assign logo_width_2x = section.settings.logo_width | times: 2 | at_most: section.settings.logo.width %}
          <img
            class="xula-footer__logo"
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            srcset="
              {{ section.settings.logo | image_url: width: section.settings.logo_width }} 1x,
              {{ section.settings.logo | image_url: width: logo_width_2x }} 2x
            "
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            style="width: {{ section.settings.logo_width }}px;"
            loading="lazy"
            decoding="async"
          >
        {% else %}
          <p class="xula-footer__wordmark">{{ section.settings.brand_heading | default: shop.name }}</p>
        {% endif %}

        {% if section.settings.brand_manifesto != blank %}
          <div class="xula-footer__manifesto rte">{{ section.settings.brand_manifesto }}</div>
        {% endif %}

        {% if section.settings.show_social and has_social %}
          {% render 'social-icons', class: 'xula-footer__socials' %}
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <nav class="xula-footer__nav" aria-label="Footer">
          <div class="xula-footer__nav-columns">
            {% for block in section.blocks %}
              {% if block.type == 'link_list' and block.settings.menu != blank %}
                <details class="xula-footer__nav-group" open {{ block.shopify_attributes }}>
                  <summary class="xula-footer__nav-heading">
                    <span>{{ block.settings.heading | default: block.settings.menu.title | escape }}</span>
                    <svg class="xula-footer__nav-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul class="xula-footer__links" role="list">
                    {% for link in block.settings.menu.links %}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="xula-footer__link"
                          {% if link.active %}aria-current="page"{% endif %}
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        </nav>
      {% endif %}
    </div>

    {% if show_localization or section.settings.payment_enable %}
      <div class="xula-footer__utility">
        {% if show_localization %}
          <div class="xula-footer__localization">
            {% if show_country %}
              {% assign country_form_id = 'XulaFooterCountryForm-' | append: section.id %}
              <div class="xula-footer__field">
                {% form 'localization', id: country_form_id, class: 'xula-footer__select-form' %}
                  <label class="xula-footer__select-label" for="XulaFooterCountry-{{ section.id }}">
                    {{ 'localization.country_label' | t | default: 'Country/region' }}
                  </label>
                  <div class="xula-footer__select-wrapper">
                    <select
                      class="xula-footer__select"
                      id="XulaFooterCountry-{{ section.id }}"
                      name="country_code"
                      autocomplete="off"
                      data-xula-localization-select
                    >
                      {% for country in localization.available_countries %}
                        <option
                          value="{{ country.iso_code }}"
                          {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                        >
                          {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                        </option>
                      {% endfor %}
                    </select>
                    <svg class="xula-footer__select-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <noscript>
                    <button type="submit" class="xula-footer__select-submit">
                      {{ 'localization.update_country' | t | default: 'Update' }}
                    </button>
                  </noscript>
                {% endform %}
              </div>
            {% endif %}

            {% if show_language %}
              {% assign language_form_id = 'XulaFooterLanguageForm-' | append: section.id %}
              <div class="xula-footer__field">
                {% form 'localization', id: language_form_id, class: 'xula-footer__select-form' %}
                  <label class="xula-footer__select-label" for="XulaFooterLanguage-{{ section.id }}">
                    {{ 'localization.language_label' | t | default: 'Language' }}
                  </label>
                  <div class="xula-footer__select-wrapper">
                    <select
                      class="xula-footer__select"
                      id="XulaFooterLanguage-{{ section.id }}"
                      name="locale_code"
                      autocomplete="off"
                      data-xula-localization-select
                    >
                      {% for language in localization.available_languages %}
                        <option
                          value="{{ language.iso_code }}"
                          lang="{{ language.iso_code }}"
                          {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                        >
                          {{ language.endonym_name | capitalize }}
                        </option>
                      {% endfor %}
                    </select>
                    <svg class="xula-footer__select-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <noscript>
                    <button type="submit" class="xula-footer__select-submit">
                      {{ 'localization.update_language' | t | default: 'Update' }}
                    </button>
                  </noscript>
                {% endform %}
              </div>
            {% endif %}

            <div class="xula-footer__status" data-xula-localization-status role="status" aria-live="polite"></div>
          </div>
        {% endif %}

        {% if section.settings.payment_enable %}
          <div class="xula-footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t | default: 'Payment methods' }}</span>
            <ul class="xula-footer__payment-list" role="list">
              {% for type in shop.enabled_payment_types %}
                <li class="xula-footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'xula-footer__payment-icon' }}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="xula-footer__bottom">
      <p class="xula-footer__copyright">
        {% if section.settings.copyright_text != blank %}
          {{ section.settings.copyright_text }}
        {% else %}
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        {% endif %}
      </p>

      {% if section.settings.show_policies and shop.policies.size > 0 %}
        <ul class="xula-footer__legal" role="list">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li>
                <a href="{{ policy.url }}" class="xula-footer__legal-link">{{ policy.title | escape }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_back_to_top %}
    <button
      type="button"
      class="xula-footer__back-to-top"
      data-xula-back-to-top
      aria-label="Back to top"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 5l-7 7h4v7h6v-7h4z" fill="currentColor"/>
      </svg>
    </button>
  {% endif %}
</footer>

{% schema %}
{
  "name": "Xula Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Brand name",
      "default": "XULA"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to brand name if empty"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "richtext",
      "id": "brand_manifesto",
      "label": "Mini manifesto",
      "default": "<p>Mexican specialty coffee, small-batch roasted to preserve every note of origin.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "info": "Leave blank to auto-generate © [year] [shop name]. All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show legal policy links",
      "default": true
    },
    {
      "type": "header",
      "content": "Back to top"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Show back-to-top button",
      "default": true
    },
    {
      "type": "header",
      "content": "SEO"
    },
    {
      "type": "checkbox",
      "id": "show_structured_data",
      "label": "Include Organization structured data",
      "info": "Disable if this is already included elsewhere in the theme to avoid duplicates.",
      "default": false
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email override",
      "info": "Defaults to shop email"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact phone"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop" } },
        { "type": "link_list", "settings": { "heading": "Origin" } },
        { "type": "link_list", "settings": { "heading": "Company" } }
      ]
    }
  ]
}
{% endschema %}
