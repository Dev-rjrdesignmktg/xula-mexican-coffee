{{ 'xula-trust-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-trust-cards.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign heading_id = 'xula-trust-cards-heading-' | append: section.id
  assign total_blocks = section.blocks.size
%}

<section
  class="xula-trust-cards"
  aria-labelledby="{{ heading_id }}"
  style="--xula-trust-cards-count: {{ total_blocks }};"
>
  <div class="page-width">

    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="xula-intro xula-trust-cards__intro">
        {% if section.settings.eyebrow != blank %}
          <span class="xula-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="xula-heading" id="{{ heading_id }}">{{ section.settings.heading }}</h2>
        {% else %}
          <h2 class="visually-hidden" id="{{ heading_id }}">Why trust XULA</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="xula-text xula-trust-cards__subtitle">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if total_blocks > 0 %}
      <ul class="xula-trust-cards__grid" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign v = block.settings.value | default: ''
            assign numeric_raw = v | remove: ',' | remove: '+' | remove: '%' | remove: '★'
            assign accent_index = forloop.index0 | modulo: 4
            assign is_link = false
            if block.settings.link != blank
              assign is_link = true
            endif
            assign sr_stat = block.settings.prefix | append: block.settings.value | append: block.settings.suffix
            assign group_thousands = 'false'
            if block.settings.group_thousands
              assign group_thousands = 'true'
            endif
          %}

          <li
            class="xula-trust-cards__card xula-trust-cards__card--accent-{{ accent_index }}"
            {{ block.shopify_attributes }}
          >
            {% if is_link %}
              <a class="xula-trust-cards__card-link" href="{{ block.settings.link }}">
            {% endif %}

            <span class="xula-trust-cards__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'founding' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="4.5" width="17" height="16" rx="2.5"/>
                    <path d="M3.5 9.5h17"/>
                    <path d="M8 2.5v4M16 2.5v4"/>
                    <path d="M8 14l2.2 2.2L16 10.5"/>
                  </svg>
                {% when 'customers' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8.5" r="3"/>
                    <path d="M2.8 19c.7-3.4 3.3-5.5 6.2-5.5s5.5 2.1 6.2 5.5"/>
                    <circle cx="17" cy="7.5" r="2.2"/>
                    <path d="M15.7 13.6c2.4.3 4.3 2.2 4.9 5"/>
                  </svg>
                {% when 'reviews' %}
                  <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="m10 1.5-1.9 6.1c-.2.7-.8 1.2-1.6 1.2H.7l4.9 3.7a1.9 1.9 0 0 1 .7 2.1L4.5 21l4.9-3.7c.7-.5 1.6-.5 2.3 0l4.9 3.7-1.9-6.4c-.2-.7 0-1.6.7-2.1l4.9-3.7h-5.8c-.8 0-1.5-.5-1.7-1.2z"/>
                  </svg>
                {% when 'origin' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21s7-6.6 7-12a7 7 0 1 0-14 0c0 5.4 7 12 7 12z"/>
                    <circle cx="12" cy="9" r="2.5"/>
                  </svg>
                {% when 'quality' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8.5" r="5.5"/>
                    <path d="M8.2 13.2 6.5 21l5.5-3 5.5 3-1.7-7.8"/>
                  </svg>
                {% when 'leaf' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20c8 0 15-6 15-15-9 0-15 6-15 15z"/>
                    <path d="M4 20c1.5-5 5-9 10-11.5"/>
                  </svg>
                {% when 'custom' %}
                  {% if block.settings.custom_icon != blank %}
                    <img
                      src="{{ block.settings.custom_icon | image_url: width: 96 }}"
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                    >
                  {% endif %}
              {% endcase %}
            </span>

            <span
              class="xula-trust-cards__stat xula-type--code"
              role="img"
              aria-label="{{ sr_stat }}"
            >
              {% if block.settings.prefix != blank %}
                <span class="xula-trust-cards__prefix">{{ block.settings.prefix }}</span>
              {% endif %}<span
                class="xula-trust-cards__value"
                data-count-to="{{ numeric_raw }}"
                data-decimals="{{ block.settings.decimals }}"
                data-group="{{ group_thousands }}"
              >{{ block.settings.value }}</span>{% if block.settings.suffix != blank %}<span class="xula-trust-cards__suffix">{{ block.settings.suffix }}</span>{% endif %}
            </span>

            {% if block.settings.show_stars %}
              {% liquid
                assign filled_stars = block.settings.rating | round
                assign review_count = block.settings.review_count
                assign stars_sr_label = block.settings.rating | append: ' out of 5 stars'
                if review_count > 0
                  assign stars_sr_label = stars_sr_label | append: ', ' | append: review_count | append: ' reviews'
                endif
              %}
              <span
                class="xula-trust-cards__stars"
                role="img"
                aria-label="{{ stars_sr_label }}"
              >
                {% for i in (1..5) %}
                  <svg class="xula-trust-cards__star{% if i <= filled_stars %} xula-trust-cards__star--filled{% endif %}" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m10 2.626-1.46 4.71c-.192.62-.743 1.041-1.365 1.041H2.453l3.82 2.91a1.55 1.55 0 0 1 .522 1.685l-1.46 4.71 3.821-2.911a1.38 1.38 0 0 1 1.688 0l3.82 2.91-1.459-4.71c-.192-.62.019-1.3.522-1.683l3.82-2.911h-4.722c-.622 0-1.173-.42-1.366-1.04z"/>
                  </svg>
                {% endfor %}
              </span>
            {% endif %}

            {% if block.settings.label != blank %}
              <span class="xula-trust-cards__label">{{ block.settings.label }}</span>
            {% endif %}

            {% if block.settings.description != blank %}
              <span class="xula-trust-cards__description">{{ block.settings.description }}</span>
            {% endif %}

            {% if is_link %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: page.url | default: shop.url | json }}
    {% for block in section.blocks %}
      {% if block.settings.icon == 'founding' and block.settings.value != blank %}
        ,"foundingDate": {{ block.settings.value | json }}
      {% endif %}
      {% if block.settings.show_stars and block.settings.value != blank %}
        ,"aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ block.settings.value | json }},
          "bestRating": "5",
          "reviewCount": {{ block.settings.review_count | default: 1 | json }}
        }
      {% endif %}
    {% endfor %}
  }
</script>

{% schema %}
{
  "name": "Xula Trust Cards",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Trust you can taste"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Numbers behind every cup"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtitle",
      "default": "Mexican tradition, verified quality, and customers who keep coming back."
    }
  ],
  "blocks": [
    {
      "type": "metric_card",
      "name": "Metric card",
      "settings": [
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "founding", "label": "Calendar (founding)" },
            { "value": "customers", "label": "Customers" },
            { "value": "reviews", "label": "Star (reviews)" },
            { "value": "origin", "label": "Origin / location" },
            { "value": "quality", "label": "Quality seal" },
            { "value": "leaf", "label": "Leaf (natural/sustainable)" },
            { "value": "custom", "label": "Custom image" }
          ],
          "default": "founding"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom image (used when icon is 'Custom image')"
        },
        {
          "type": "header",
          "content": "Metric"
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix (optional)",
          "info": "E.g. '+', 'Since'"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2015",
          "info": "The card's main number or figure. E.g. 2015, 50000, 4.9, 100"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix (optional)",
          "info": "E.g. '%', '+'"
        },
        {
          "type": "select",
          "id": "decimals",
          "label": "Decimals when animating",
          "options": [
            { "value": "0", "label": "0" },
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" }
          ],
          "default": "0"
        },
        {
          "type": "checkbox",
          "id": "group_thousands",
          "label": "Group thousands (1,000)",
          "info": "Turn on for large numbers (e.g. 50000) so they display with a comma. Leave off for years or small values.",
          "default": false
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Founding year"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description (optional)"
        },
        {
          "type": "header",
          "content": "Star reviews (optional)"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show star rating",
          "default": false
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 0.1,
          "default": 5
        },
        {
          "type": "number",
          "id": "review_count",
          "label": "Number of reviews",
          "default": 500
        },
        {
          "type": "header",
          "content": "Link (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Trust Cards",
      "blocks": [
        {
          "type": "metric_card",
          "settings": {
            "icon": "founding",
            "value": "2015",
            "label": "Founding year",
            "description": "Mexican tradition since the source",
            "group_thousands": false
          }
        },
        {
          "type": "metric_card",
          "settings": {
            "icon": "customers",
            "prefix": "+",
            "value": "50000",
            "suffix": "",
            "label": "Happy customers",
            "description": "And growing every day",
            "group_thousands": true
          }
        },
        {
          "type": "metric_card",
          "settings": {
            "icon": "reviews",
            "value": "4.9",
            "label": "Customer reviews",
            "decimals": "1",
            "show_stars": true,
            "rating": 4.9,
            "review_count": 500
          }
        },
        {
          "type": "metric_card",
          "settings": {
            "icon": "origin",
            "value": "100",
            "suffix": "%",
            "label": "Mexican origin",
            "description": "From the highlands of Mexico to your cup"
          }
        }
      ]
    }
  ]
}
{% endschema %}
