{{ 'xula-contact-premium.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-contact-premium.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign uid = section.id
  assign heading_id = 'XulaContactHeading-' | append: uid
  assign form_id = 'XulaContactForm-' | append: uid
  assign status_id = 'XulaContactStatus-' | append: uid
  assign name_id = 'XulaContactName-' | append: uid
  assign email_id = 'XulaContactEmail-' | append: uid
  assign subject_id = 'XulaContactSubject-' | append: uid
  assign message_id = 'XulaContactMessage-' | append: uid
  assign subject_options = section.settings.subject_options | newline_to_br | split: '<br />'
  assign wa_digits = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign hours_blocks = section.blocks | where: 'type', 'hours'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign has_social = false
  if section.settings.show_social
    if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank or settings.social_pinterest_link != blank
      assign has_social = true
    endif
  endif
  assign contact_email = section.settings.email | default: shop.email
%}

{% if section.settings.show_structured_data %}
  {% assign ld_image = section.settings.bg_image | default: settings.logo %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": {{ section.settings.heading | strip_html | json }},
      "url": {{ canonical_url | json }},
      "mainEntity": {
        "@type": "LocalBusiness",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | json }},
        {% if ld_image != blank %}
          "image": {{ ld_image | image_url: width: 1200 | prepend: 'https:' | json }},
        {% endif %}
        {% if contact_email != blank %}
          "email": {{ contact_email | json }},
        {% endif %}
        {% if wa_digits != blank %}
          "telephone": {{ '+' | append: wa_digits | json }},
        {% endif %}
        {% if section.settings.opening_hours_schema != blank %}
          "openingHours": {{ section.settings.opening_hours_schema | split: ',' | json }},
        {% endif %}
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          {% if contact_email != blank %}"email": {{ contact_email | json }},{% endif %}
          {% if wa_digits != blank %}"telephone": {{ '+' | append: wa_digits | json }},{% endif %}
          "availableLanguage": ["en", "es"]
        },
        "sameAs": [
          {%- assign sep = '' -%}
          {%- if settings.social_instagram_link != blank -%}{{ sep }}{{ settings.social_instagram_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}{{ sep }}{{ settings.social_facebook_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}{{ sep }}{{ settings.social_tiktok_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}{{ sep }}{{ settings.social_youtube_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}{{ sep }}{{ settings.social_pinterest_link | json }}{%- endif -%}
        ]
      }
    }
  </script>
{% endif %}

<section
  class="xula-contact-premium{% if section.settings.bg_image != blank %} xula-contact-premium--has-bg{% endif %}"
  id="xula-contact-premium-{{ uid }}"
  aria-labelledby="{{ heading_id }}"
  style="
    --xula-contact-bg: {{ section.settings.bg_color }};
    --xula-contact-ink: {{ section.settings.text_color }};
    --xula-contact-bg-opacity: {{ section.settings.bg_opacity | divided_by: 100.0 }};
    --xula-contact-pt: {{ section.settings.padding_top }}px;
    --xula-contact-pb: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.bg_image != blank %}
    <div class="xula-contact-premium__bg" aria-hidden="true">
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag:
          class: 'xula-contact-premium__bg-image',
          widths: '600, 1000, 1500, 2000',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    </div>
  {% endif %}

  <div class="page-width">
    <div class="xula-contact-premium__grid">

      {%- comment -%} Left column: info & branding {%- endcomment -%}
      <div class="xula-contact-premium__info">
        {% if section.settings.eyebrow != blank %}
          <p class="xula-contact-premium__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h2 class="xula-contact-premium__heading" id="{{ heading_id }}">{{ section.settings.heading }}</h2>

        {% if section.settings.intro != blank %}
          <div class="xula-contact-premium__intro">{{ section.settings.intro }}</div>
        {% endif %}

        <dl class="xula-contact-premium__details">
          {% if contact_email != blank %}
            <div class="xula-contact-premium__detail xula-contact-premium__detail--email">
              <dt class="xula-contact-premium__label">{{ section.settings.email_label }}</dt>
              <dd class="xula-contact-premium__value">
                <a class="xula-contact-premium__link" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
              </dd>
            </div>
          {% endif %}

          {% if wa_digits != blank %}
            <div class="xula-contact-premium__detail xula-contact-premium__detail--phone">
              <dt class="xula-contact-premium__label">{{ section.settings.phone_label }}</dt>
              <dd class="xula-contact-premium__value">
                <a
                  class="xula-contact-premium__link"
                  href="https://wa.me/{{ wa_digits }}{% if section.settings.whatsapp_message != blank %}?text={{ section.settings.whatsapp_message | url_encode }}{% endif %}"
                  target="_blank"
                  rel="noopener"
                >
                  {{ section.settings.phone_display | default: wa_digits }}
                  <span class="visually-hidden">({{ section.settings.whatsapp_a11y_label }})</span>
                </a>
              </dd>
              <dd class="xula-contact-premium__meta-link">
                <a class="xula-contact-premium__sublink" href="tel:+{{ wa_digits }}">{{ section.settings.call_label }}</a>
              </dd>
            </div>
          {% endif %}

          {% if hours_blocks.size > 0 %}
            <div class="xula-contact-premium__detail xula-contact-premium__detail--hours">
              <dt class="xula-contact-premium__label">{{ section.settings.hours_label }}</dt>
              <dd class="xula-contact-premium__value">
                <ul class="xula-contact-premium__hours" role="list">
                  {% for block in hours_blocks %}
                    <li class="xula-contact-premium__hours-row" {{ block.shopify_attributes }}>
                      <span class="xula-contact-premium__hours-day">{{ block.settings.days }}</span>
                      <span class="xula-contact-premium__hours-time">{{ block.settings.time }}</span>
                    </li>
                  {% endfor %}
                </ul>
              </dd>
            </div>
          {% endif %}
        </dl>

        {% if has_social %}
          <nav class="xula-contact-premium__social" aria-label="{{ shop.name | append: ' social media' | escape }}">
            <ul class="xula-contact-premium__social-list" role="list">
              {% if settings.social_instagram_link != blank %}
                <li><a class="xula-contact-premium__social-link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a></li>
              {% endif %}
              {% if settings.social_facebook_link != blank %}
                <li><a class="xula-contact-premium__social-link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a></li>
              {% endif %}
              {% if settings.social_tiktok_link != blank %}
                <li><a class="xula-contact-premium__social-link" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a></li>
              {% endif %}
              {% if settings.social_youtube_link != blank %}
                <li><a class="xula-contact-premium__social-link" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a></li>
              {% endif %}
              {% if settings.social_pinterest_link != blank %}
                <li><a class="xula-contact-premium__social-link" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a></li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}

        {% if trust_blocks.size > 0 %}
          <ul class="xula-contact-premium__trust" role="list">
            {% for block in trust_blocks %}
              <li class="xula-contact-premium__trust-item" {{ block.shopify_attributes }}>
                <span class="xula-contact-premium__trust-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'clock' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {% when 'grinder' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9h12l-1.5 11h-9z"/><path d="M8 9V6h8v3M12 6V3M10 3h4"/></svg>
                    {% when 'cup' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9h13v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 4 6v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
                  {% endcase %}
                </span>
                <span class="xula-contact-premium__trust-copy">
                  <strong class="xula-contact-premium__trust-title">{{ block.settings.title }}</strong>
                  {% if block.settings.text != blank %}
                    <span class="xula-contact-premium__trust-text">{{ block.settings.text }}</span>
                  {% endif %}
                </span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {%- comment -%} Right column: contact form {%- endcomment -%}
      <div class="xula-contact-premium__panel">
        {% if section.settings.form_heading != blank %}
          <h3 class="xula-contact-premium__form-heading">{{ section.settings.form_heading }}</h3>
        {% endif %}
        <p class="xula-contact-premium__required-note">{{ section.settings.required_note }}</p>

        {% form 'contact', id: form_id, class: 'xula-contact-premium__form', data-xula-contact-form: true %}
          {% liquid
            assign name_value = form.name
            if name_value == blank and customer
              assign name_value = customer.name
            endif
            assign email_value = form.email
            if email_value == blank and customer
              assign email_value = customer.email
            endif
            assign error_fields = ''
            if form.errors
              for field in form.errors
                assign error_fields = error_fields | append: ',' | append: field
              endfor
            endif
          %}

          <div
            class="xula-contact-premium__status"
            id="{{ status_id }}"
            tabindex="-1"
            data-xula-contact-status
            data-msg-required="{{ section.settings.error_required | escape }}"
            data-msg-select="{{ section.settings.error_select | escape }}"
            data-msg-email="{{ section.settings.error_email | escape }}"
            data-msg-minlength="{{ section.settings.error_minlength | escape }}"
            data-msg-summary="{{ section.settings.error_summary | escape }}"
            data-msg-sending="{{ section.settings.sending_label | escape }}"
          >
            {% if form.posted_successfully? %}
              <div class="xula-contact-premium__alert xula-contact-premium__alert--success" role="status">
                <strong class="xula-contact-premium__alert-title">{{ section.settings.success_heading }}</strong>
                <span>{{ section.settings.success_text }}</span>
              </div>
            {% elsif form.errors %}
              <div class="xula-contact-premium__alert xula-contact-premium__alert--error" role="alert">
                <strong class="xula-contact-premium__alert-title">{{ section.settings.error_heading }}</strong>
                <ul class="xula-contact-premium__alert-list">
                  {% for field in form.errors %}
                    <li>
                      {% if field == 'form' %}
                        {{ form.errors.messages[field] }}
                      {% else %}
                        {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
          <div class="visually-hidden" aria-live="assertive" data-xula-contact-live></div>

          <div class="xula-contact-premium__field" data-xula-field>
            <label class="xula-contact-premium__field-label" for="{{ name_id }}">
              {{ section.settings.name_label }} <span class="xula-contact-premium__req" aria-hidden="true">*</span>
            </label>
            <input
              class="xula-contact-premium__input"
              type="text"
              id="{{ name_id }}"
              name="contact[name]"
              value="{{ name_value | escape }}"
              autocomplete="name"
              required
              minlength="2"
              aria-describedby="{{ name_id }}-error"
              {% if error_fields contains ',name' %}aria-invalid="true"{% endif %}
            >
            <p class="xula-contact-premium__error" id="{{ name_id }}-error" data-xula-error hidden></p>
          </div>

          <div class="xula-contact-premium__field" data-xula-field>
            <label class="xula-contact-premium__field-label" for="{{ email_id }}">
              {{ section.settings.email_label }} <span class="xula-contact-premium__req" aria-hidden="true">*</span>
            </label>
            <input
              class="xula-contact-premium__input"
              type="email"
              id="{{ email_id }}"
              name="contact[email]"
              value="{{ email_value | escape }}"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-describedby="{{ email_id }}-error"
              {% if error_fields contains ',email' %}aria-invalid="true"{% endif %}
            >
            <p class="xula-contact-premium__error" id="{{ email_id }}-error" data-xula-error hidden></p>
          </div>

          <div class="xula-contact-premium__field" data-xula-field>
            <label class="xula-contact-premium__field-label" id="{{ subject_id }}-label" for="{{ subject_id }}-native">
              {{ section.settings.subject_label }} <span class="xula-contact-premium__req" aria-hidden="true">*</span>
            </label>
            <div class="xula-contact-premium__select" data-xula-select>
              <select
                class="xula-contact-premium__input xula-contact-premium__select-native"
                id="{{ subject_id }}-native"
                name="contact[Subject]"
                required
                aria-describedby="{{ subject_id }}-error"
                {% if error_fields contains ',Subject' %}aria-invalid="true"{% endif %}
                data-xula-select-native
              >
                <option value=""{% if form.Subject == blank %} selected{% endif %}>{{ section.settings.subject_placeholder }}</option>
                {% for option in subject_options %}
                  {% assign opt = option | strip %}
                  {% if opt != blank %}
                    <option value="{{ opt | escape }}"{% if form.Subject == opt %} selected{% endif %}>{{ opt }}</option>
                  {% endif %}
                {% endfor %}
              </select>

              <div
                class="xula-contact-premium__input xula-contact-premium__select-trigger"
                id="{{ subject_id }}"
                role="combobox"
                tabindex="0"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="{{ subject_id }}-listbox"
                aria-labelledby="{{ subject_id }}-label"
                aria-describedby="{{ subject_id }}-error"
                aria-required="true"
                hidden
                data-xula-select-trigger
              >
                <span class="xula-contact-premium__select-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" focusable="false"><ellipse cx="12" cy="12" rx="6.5" ry="9" transform="rotate(35 12 12)"/><path d="M9.2 5.6c3.4 2.4-.2 6.6 2.6 9.6 1.1 1.2 2.4 1.9 3.6 2.3"/></svg>
                </span>
                <span class="xula-contact-premium__select-stack">
                  <span class="xula-contact-premium__select-kicker" aria-hidden="true" data-xula-select-kicker>&mdash; / {{ subject_options.size | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="xula-contact-premium__select-value" data-xula-select-value>{{ section.settings.subject_placeholder }}</span>
                </span>
              </div>

              <div class="xula-contact-premium__select-panel" hidden data-xula-select-panel>
                <p class="xula-contact-premium__select-head" aria-hidden="true">
                  <span>{{ section.settings.subject_placeholder }}</span>
                  <span class="xula-contact-premium__select-count">{{ subject_options.size | prepend: '0' | slice: -2, 2 }}</span>
                </p>
                <ul
                  class="xula-contact-premium__select-list"
                  id="{{ subject_id }}-listbox"
                  role="listbox"
                  aria-labelledby="{{ subject_id }}-label"
                  tabindex="-1"
                  data-xula-select-list
                >
                  {% for option in subject_options %}
                    {% assign opt = option | strip %}
                    {% if opt != blank %}
                      <li
                        class="xula-contact-premium__select-option"
                        id="{{ subject_id }}-option-{{ forloop.index }}"
                        role="option"
                        aria-selected="false"
                        data-value="{{ opt | escape }}"
                      >
                        <span class="xula-contact-premium__select-index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                        <span class="xula-contact-premium__select-text">{{ opt }}</span>
                        <svg class="xula-contact-premium__select-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>

              <svg class="xula-contact-premium__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <p class="xula-contact-premium__error" id="{{ subject_id }}-error" data-xula-error hidden></p>
          </div>

          <div class="xula-contact-premium__field" data-xula-field>
            <label class="xula-contact-premium__field-label" for="{{ message_id }}">
              {{ section.settings.message_label }} <span class="xula-contact-premium__req" aria-hidden="true">*</span>
            </label>
            <textarea
              class="xula-contact-premium__input xula-contact-premium__textarea"
              id="{{ message_id }}"
              name="contact[body]"
              rows="6"
              required
              minlength="10"
              maxlength="2000"
              aria-describedby="{{ message_id }}-hint {{ message_id }}-error"
            >{{ form.body }}</textarea>
            <div class="xula-contact-premium__meta">
              <p class="xula-contact-premium__hint" id="{{ message_id }}-hint">{{ section.settings.message_hint }}</p>
              <span class="xula-contact-premium__counter" aria-hidden="true" data-xula-counter>0 / 2000</span>
            </div>
            <p class="xula-contact-premium__error" id="{{ message_id }}-error" data-xula-error hidden></p>
          </div>

          <button type="submit" class="xula-btn xula-contact-premium__submit" data-xula-contact-submit>
            <span data-xula-contact-submit-label>{{ section.settings.button_label }}</span>
          </button>

          {% if section.settings.privacy_text != blank %}
            <div class="xula-contact-premium__privacy">{{ section.settings.privacy_text }}</div>
          {% endif %}
        {% endform %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xula Contact Premium",
  "tag": "div",
  "class": "xula-contact-premium-wrapper",
  "settings": [
    { "type": "header", "content": "Editorial content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personal Concierge" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's Talk About Your Next Cup" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Behind every message is a XULA coffee specialist. We'll help you choose the right origin, dial in your grind, or sort out anything about your order.</p>"
    },

    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email", "label": "Contact email", "info": "Leave blank to use the store email" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "WhatsApp / Phone" },
    { "type": "text", "id": "phone_display", "label": "Phone (displayed)", "default": "+52 55 1234 5678" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (international format)", "info": "Digits only, e.g. 525512345678", "default": "525512345678" },
    { "type": "text", "id": "whatsapp_message", "label": "WhatsApp prefilled message", "default": "Hi XULA, I'd love some advice on choosing my coffee." },
    { "type": "text", "id": "whatsapp_a11y_label", "label": "WhatsApp accessible text", "default": "opens WhatsApp in a new tab" },
    { "type": "text", "id": "call_label", "label": "Call link text", "default": "or give us a call" },
    { "type": "text", "id": "hours_label", "label": "Hours label", "default": "Support hours" },

    { "type": "header", "content": "Social media" },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "info": "Uses the links from Theme settings > Social media", "default": true },

    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Write to Us" },
    { "type": "text", "id": "required_note", "label": "Required fields note", "default": "Fields marked with * are required." },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "subject_label", "label": "Subject label", "default": "Reason for inquiry" },
    { "type": "text", "id": "subject_placeholder", "label": "Subject placeholder", "default": "Select an option" },
    {
      "type": "textarea",
      "id": "subject_options",
      "label": "Subject options",
      "info": "One option per line",
      "default": "Grind & brewing advice\nOrder status\nSubscriptions\nWholesale / HORECA\nCorporate gifting\nOther"
    },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "message_hint", "label": "Message hint", "default": "Tell us your brewing method and your favorite tasting notes." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send Message" },
    { "type": "text", "id": "sending_label", "label": "Sending label", "default": "Sending…" },
    { "type": "richtext", "id": "privacy_text", "label": "Privacy text", "default": "<p>We only use your details to reply to your inquiry.</p>" },

    { "type": "header", "content": "Status messages" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Message received!" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "A XULA specialist will get back to you within 24 hours." },
    { "type": "text", "id": "error_heading", "label": "Server error heading", "default": "We couldn't send your message" },
    { "type": "text", "id": "error_summary", "label": "Error summary", "info": "[count] is replaced with the number of fields", "default": "Please review [count] highlighted field(s)." },
    { "type": "text", "id": "error_required", "label": "Required field error", "default": "This field is required." },
    { "type": "text", "id": "error_select", "label": "Subject not selected error", "default": "Please choose a reason for your inquiry." },
    { "type": "text", "id": "error_email", "label": "Invalid email error", "default": "Enter a valid email, e.g. name@email.com." },
