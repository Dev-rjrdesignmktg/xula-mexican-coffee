{{ "xula-proof.css" | asset_url | stylesheet_tag }}
<script src="{{ 'xula-proof.js' | asset_url }}" defer></script>

<section class="xula-proof" data-xula-proof>
  <div class="page-width">

    <header class="xula-proof__intro">
      <div class="xula-proof__intro-main">
        {% if section.settings.eyebrow != blank %}
          <span class="xula-eyebrow xula-proof__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="xula-heading xula-proof__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.settings.text != blank %}
        <p class="xula-text xula-proof__lead">{{ section.settings.text }}</p>
      {% endif %}
    </header>

    <div class="xula-proof__grid" role="list">
      {% for block in section.blocks %}
        <article
          class="xula-proof__card"
          role="listitem"
          style="
            --xula-proof-bg: {{ block.settings.background_color }};
            --xula-proof-text: {{ block.settings.text_color }};
            --xula-proof-i: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <div class="xula-proof__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 768px) 55vw, 85vw',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {% endif %}
          </div>

          <div class="xula-proof__content">
            <div class="xula-proof__meta" aria-hidden="true">
              <span class="xula-proof__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="xula-proof__rule"></span>
            </div>

            <h3 class="xula-subheading xula-proof__title">{{ block.settings.title }}</h3>
            <p class="xula-text xula-proof__text">{{ block.settings.text }}</p>
          </div>
        </article>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
    {
        "name": "Xula Proof of Craft",
        "max_blocks": 3,
        "settings": [
            {
              "type": "text",
              "id": "eyebrow",
              "label": "Eyebrow",
              "default": "Rooted in tradition"
            },
            {
              "type": "text",
              "id": "heading",
              "label": "Heading",
              "default": "Crafted with purpose, from bean to ritual."
            },
            {
              "type": "textarea",
              "id": "text",
              "label": "Intro text",
              "default": "Three principles guide every bag we roast, from the Mexican highlands to your morning cup."
            }
        ],
        "blocks": [
            {
                "type": "craft_item",
                "name": "Craft Item",
                "settings": [
                    {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                    },
                    {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Single-Origin Mexican Coffee"
                    },
                    {
                    "type": "textarea",
                    "id": "text",
                    "label": "Description",
                    "default": "Sourced from the highlands of Mexico, where altitude, soil, and climate shape every cup."
                    },
                    {
                      "type": "color",
                      "id": "background_color",
                      "label": "Background color",
                      "default": "#F4F0E8"
                    },
                    {
                      "type": "color",
                      "id": "text_color",
                      "label": "Text color",
                      "default": "#1C1C1C"
                    }
                ]
            }
        ],
    "presets": [
        {
            "name": "Xula Proof of Craft",
            "blocks": [
                {
                "type": "craft_item"
                },
                {
                "type": "craft_item"
                },
                {
                "type": "craft_item"
                }
            ]
        }
    ]
}
{% endschema %}
