{{ 'xula-blog-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-blog-list.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign list_id = 'XulaBlogList-' | append: section.id
  assign list_blog = section.settings.blog | default: blog
  assign articles_to_show = section.settings.articles_to_show | default: 12
  assign initial_visible = section.settings.initial_visible | default: 4
  assign skip_articles = section.settings.skip_articles | default: 0
  assign enable_load_more = section.settings.enable_load_more

  if list_blog != blank
    assign articles = list_blog.articles | slice: skip_articles, articles_to_show
  else
    assign articles = empty
  endif
-%}

<section class="xula-blog-list" id="{{ list_id }}" aria-labelledby="{{ list_id }}-heading">
  <div class="page-width page-width--narrow">

    {%- if section.settings.heading != blank -%}
      <div class="xula-blog-list__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="xula-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="xula-blog-list__heading" id="{{ list_id }}-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if articles.size > 0 -%}
      <ul class="xula-blog-list__rows" data-blog-list-rows data-initial-visible="{{ initial_visible }}" role="list">
        {%- for article in articles -%}
          {%- assign category = article.tags.first -%}
          {%- assign article_image = article.image -%}
          {%- assign img_alt = article_image.alt | default: article.title | escape -%}
          {%- assign row_remainder = forloop.index0 | modulo: 2 -%}

          <li
            class="xula-blog-list__row{% if section.settings.alternate_sides and row_remainder == 1 %} xula-blog-list__row--reverse{% endif %}"
            data-blog-list-row
          >
            <a href="{{ article.url }}" class="xula-blog-list__link" aria-labelledby="{{ list_id }}-title-{{ forloop.index }}">
              <div class="xula-blog-list__text">
                {%- if section.settings.show_category and category != blank -%}
                  <span class="xula-blog-list__category">{{ category }}</span>
                {%- endif -%}

                <h3 class="xula-blog-list__title" id="{{ list_id }}-title-{{ forloop.index }}">
                  <span class="xula-blog-list__title-text">{{ article.title }}</span>
                  <svg class="xula-blog-list__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </h3>

                {%- if section.settings.show_author and article.author != blank -%}
                  <p class="xula-blog-list__author">by {{ article.author }}</p>
                {%- endif -%}
              </div>

              <div class="xula-blog-list__media">
                {%- if article_image -%}
                  <img
                    class="xula-blog-list__image"
                    src="{{ article_image | image_url: width: 700 }}"
                    srcset="
                      {{ article_image | image_url: width: 400 }} 400w,
                      {{ article_image | image_url: width: 700 }} 700w,
                      {{ article_image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 700px) 35vw, 100vw"
                    alt="{{ img_alt }}"
                    width="{{ article_image.width }}"
                    height="{{ article_image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'xula-blog-list__image xula-blog-list__image--placeholder' }}
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if enable_load_more and articles.size > initial_visible -%}
        <div class="xula-blog-list__load-more-wrap" data-blog-list-load-more-wrap>
          <button
            type="button"
            class="xula-btn--secondary xula-blog-list__load-more"
            data-blog-list-load-more
            aria-controls="{{ list_id }}"
            aria-expanded="false"
          >
            <span>{{ section.settings.load_more_label | default: 'Load More' }}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M12 5v14M5 12l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="xula-blog-list__empty">Select a blog with published articles to display them here.</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Xula Blog List",
  "tag": "section",
  "class": "section-xula-blog-list",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More from the Blog"
    },
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Leave blank to automatically use the current blog when this section is placed on a blog page."
    },
    {
      "type": "range",
      "id": "skip_articles",
      "label": "Skip first N articles",
      "info": "Use this to avoid repeating articles already shown in a grid section above (e.g. skip 12 if that section shows the first 12).",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Row content"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category tag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alternate_sides",
      "label": "Alternate image side per row",
      "default": true
    },
    {
      "type": "header",
      "content": "Load more"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "Enable \"Load More\" button",
      "default": true
    },
    {
      "type": "range",
      "id": "initial_visible",
      "label": "Rows visible before \"Load More\"",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "\"Load More\" label",
      "default": "Load More"
    }
  ],
  "presets": [
    {
      "name": "Xula Blog List"
    }
  ]
}
{% endschema %}
