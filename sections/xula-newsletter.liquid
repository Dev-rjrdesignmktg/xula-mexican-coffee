{{ 'xula-newsletter.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-newsletter.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign heading_id = 'XulaNewsletterHeading-' | append: section.id
  assign form_id = 'XulaNewsletterForm-' | append: section.id
  assign email_id = 'XulaNewsletterEmail-' | append: section.id
  assign status_id = 'XulaNewsletterStatus-' | append: section.id
  assign consent_id = 'XulaNewsletterConsent-' | append: section.id
  assign hp_id = 'XulaNewsletterCompany-' | append: section.id

  assign image = section.settings.image
  assign img_alt = section.settings.image_alt | default: image.alt

  assign describedby = status_id
  if section.settings.consent_text != blank
    assign describedby = consent_id | append: ' ' | append: status_id
  endif

  assign loading_label = section.settings.loading_label | default: 'Sending…'
%}

<section
  id="xula-newsletter-{{ section.id }}"
  class="xula-newsletter{% if image == blank %} xula-newsletter--no-image{% endif %}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width">
    <div class="xula-newsletter__frame">
      {%- if image != blank -%}
        <div class="xula-newsletter__media">
          {{
            image
            | image_url: width: 1400
            | image_tag:
              class: 'xula-newsletter__image',
              widths: '480, 768, 1100, 1400',
              sizes: '(min-width: 900px) 45vw, 100vw',
              alt: img_alt,
              loading: 'lazy',
              decoding: 'async'
          }}
        </div>
      {%- endif -%}

      <div class="xula-newsletter__panel">
        {%- if section.settings.eyebrow != blank -%}
          <p class="xula-newsletter__badge">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="xula-newsletter__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>

        {%- if section.settings.text != blank -%}
          <p class="xula-newsletter__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="xula-newsletter__benefits" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank -%}
                <li class="xula-newsletter__benefit" {{ block.shopify_attributes }}>
                  <span class="xula-newsletter__benefit-icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'discount' -%}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M20 12 12 20a2 2 0 0 1-2.8 0l-6.2-6.2a2 2 0 0 1 0-2.8L11 3h9v9zM8 8a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
                      {%- when 'batch' -%}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M6 2h12l-1.5 6.5L20 12v10H4V12l3.5-3.5zm2.4 2 1.1 5H8v2h8v-2h-1.5l1.1-5H8.4z"/></svg>
                      {%- when 'tips' -%}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2a7 7 0 0 0-4 12.7V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.3A7 7 0 0 0 12 2zM9 21h6v1a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.4 0-8 2.2-8 5v3h16v-3c0-2.8-3.6-5-8-5z"/></svg>
                    {%- endcase -%}
                  </span>
                  <span class="xula-newsletter__benefit-label">{{ block.settings.label | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_incentive and section.settings.incentive_badge != blank -%}
          <div class="xula-newsletter__incentive">
            <svg class="xula-newsletter__incentive-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M10 1 3 4v5c0 5 3 8.5 7 9.5 4-1 7-4.5 7-9.5V4zm-1.2 12.4-3-3 1.4-1.4 1.6 1.6 4-4 1.4 1.4z"/>
            </svg>
            <p class="xula-newsletter__incentive-text">
              <strong>{{ section.settings.incentive_badge | escape }}</strong>
              {%- if section.settings.incentive_detail != blank -%}
                <span>{{ section.settings.incentive_detail | escape }}</span>
              {%- endif -%}
            </p>
          </div>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'xula-newsletter__form', data-newsletter-form: true -%}
          <div
            class="xula-newsletter__form-wrapper{% if form.posted_successfully? %} is-success{% endif %}"
            data-newsletter-wrapper
            data-success-heading="{{ section.settings.success_heading | escape }}"
            data-success-text="{{ section.settings.success_text | escape }}"
            data-error-text="{{ section.settings.error_text | escape }}"
            data-invalid-text="{{ section.settings.invalid_text | escape }}"
            data-loading-label="{{ loading_label | escape }}"
          >
            <input type="hidden" name="contact[tags]" value="newsletter,xula-signup">

            <div class="xula-newsletter__hp-field" aria-hidden="true">
              <label for="{{ hp_id }}">Company</label>
              <input type="text" id="{{ hp_id }}" name="contact[company]" tabindex="-1" autocomplete="off">
            </div>

            <div class="xula-newsletter__field-row">
              <div class="xula-newsletter__field">
                <label class="visually-hidden" for="{{ email_id }}">
                  {{- 'newsletter.label' | t | default: 'Email address' -}}
                </label>
                <input
                  type="email"
                  id="{{ email_id }}"
                  name="contact[email]"
                  class="xula-newsletter__input"
                  value="{{ form.email | escape }}"
                  placeholder="{{ section.settings.email_placeholder | escape }}"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  inputmode="email"
                  required
                  aria-describedby="{{ describedby }}"
                  {% if form.errors %}
                    aria-invalid="true"
                  {% endif %}
                  data-newsletter-input
                >
                <button type="submit" class="xula-btn xula-newsletter__submit" data-newsletter-submit>
                  <span data-newsletter-submit-label>{{ section.settings.button_label | escape }}</span>
                </button>
              </div>
            </div>

            {%- if section.settings.consent_text != blank -%}
              <p class="xula-newsletter__consent" id="{{ consent_id }}">{{ section.settings.consent_text | escape }}</p>
            {%- endif -%}

            <div
              class="xula-newsletter__status"
              id="{{ status_id }}"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-newsletter-status
            >
              {%- if form.posted_successfully? -%}
                <p class="xula-newsletter__message xula-newsletter__message--success" tabindex="-1">
                  <strong>{{ section.settings.success_heading | escape }}</strong>
                  {{ section.settings.success_text | escape }}
                </p>
              {%- elsif form.errors -%}
                <p class="xula-newsletter__message xula-newsletter__message--error" role="alert">
                  {{ form.errors.messages['email'] | default: section.settings.error_text | escape }}
                </p>
              {%- endif -%}
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xula Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Exclusive Access"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Origin of Your Coffee"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Join the XULA community and get early access to limited batches, exclusive tasting notes, and a welcome gift on your first bag."
    },
    {
      "type": "header",
      "content": "Incentive (CRO)"
    },
    {
      "type": "checkbox",
      "id": "show_incentive",
      "label": "Show incentive badge",
      "default": true
    },
    {
      "type": "text",
      "id": "incentive_badge",
      "label": "Incentive text",
      "default": "10% OFF Your First Bag"
    },
    {
      "type": "text",
      "id": "incentive_detail",
      "label": "Incentive detail",
      "default": "Code sent to your inbox instantly"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email field placeholder",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get My Discount"
    },
    {
      "type": "text",
      "id": "loading_label",
      "label": "Button label while sending",
      "default": "Sending…"
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Consent text",
      "default": "By subscribing, you agree to receive marketing emails from XULA. You can unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "Status messages"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "You're in! Check your inbox."
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Success text",
      "default": "We sent your welcome code. In the meantime, brew your favorite cup."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Generic error text",
      "default": "Something went wrong. Please try again in a few seconds."
    },
    {
      "type": "text",
      "id": "invalid_text",
      "label": "Invalid email text",
      "default": "Please enter a valid email address."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the image for screen readers and search engines. Leave blank to use the alt text set in Files."
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "discount", "label": "Discount" },
            { "value": "batch", "label": "Limited batch" },
            { "value": "tips", "label": "Brewing tips" },
            { "value": "community", "label": "Community" }
          ],
          "default": "discount"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "10% off your first order"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xula Newsletter",
      "blocks": [
        { "type": "benefit_item", "settings": { "icon": "discount", "label": "10% off your first order" } },
        { "type": "benefit_item", "settings": { "icon": "batch", "label": "Early access to limited batches" } },
        { "type": "benefit_item", "settings": { "icon": "tips", "label": "Brewing guides and tasting notes" } }
      ]
    }
  ]
}
{% endschema %}
