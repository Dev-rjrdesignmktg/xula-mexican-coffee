{{ "xula-collections.css" | asset_url | stylesheet_tag }}

<section
  class="xula-collections"
  style="
    --xula-collections-bg: {{ section.settings.background_color }};
    --xula-collections-text: {{ section.settings.text_color }};
  "
>
  <div class="page-width">

    {% if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    %}
      <div class="xula-intro">

        {% if section.settings.eyebrow != blank %}
          <span class="xula-eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="xula-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="xula-text text--collections">
            {{ section.settings.description }}
          </p>
        {% endif %}

      </div>
    {% endif %}


    <div class="xula-mosaic">

      {% for block in section.blocks %}

        {% assign card_class = 'standard' %}

        {% if forloop.index == 1 %}
          {% assign card_class = 'large' %}
        {% elsif forloop.index == 4 %}
          {% assign card_class = 'full' %}
        {% endif %}


        <a
          href="{{ block.settings.link | default: '#' }}"
          class="
            xula-mosaic__item
            xula-mosaic__item--{{ card_class }}
          "
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400, 1600',
                sizes: '(min-width: 991px) 80vw, 100vw',
                alt: block.settings.title | escape
            }}

          {% else %}

            <div class="xula-mosaic__placeholder"></div>

          {% endif %}


          <div class="xula-mosaic__overlay"></div>


          <div class="xula-mosaic__content">

            {% if block.settings.title != blank %}
              <span class="xula-mosaic__title">
                {{ block.settings.title }}
              </span>
            {% endif %}

            {% if block.settings.text_description != blank %}
              <p class="xula-mosaic__description">
                {{ block.settings.text_description }}
              </p>
            {% endif %}

            {% if block.settings.link != blank %}
              <span class="xula-mosaic__link">
                Explore
                <span aria-hidden="true">→</span>
              </span>
            {% endif %}

          </div>

        </a>

      {% endfor %}

    </div>

  </div>
</section>


{% schema %}

{
  "name": "Xula Collections Mosaic",
  "tag": "section",
  "class": "xula-collections-section",
  "max_blocks": 4,

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Crafted for every ritual"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover the ritual that fits your moment."
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From specialty coffee to artisan chocolate and warm baked goods, every offering is made to elevate your daily experience."
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#439105"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F0E8"
    }

  ],

  "blocks": [

    {
      "type": "collection",
      "name": "Collection",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Specialty Coffee"
        },

        {
          "type": "textarea",
          "id": "text_description",
          "label": "Description",
          "default": "From your first sip in the morning to your sweetest evening comfort, XULA creates moments worth slowing down for."
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Xula Collections Mosaic",

      "blocks": [

        {
          "type": "collection",
          "settings": {
            "title": "Specialty Coffee"
          }
        },

        {
          "type": "collection",
          "settings": {
            "title": "Artisan Chocolate"
          }
        },

        {
          "type": "collection",
          "settings": {
            "title": "Fresh Muffins"
          }
        },

        {
          "type": "collection",
          "settings": {
            "title": "Xula Experiences"
          }
        }

      ]

    }

  ]

}

{% endschema %}