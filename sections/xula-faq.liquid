{{ 'xula-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xula-faq.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign heading_id = 'xula-faq-heading-' | append: section.id
  assign open_first = section.settings.open_first
  assign allow_multiple = section.settings.allow_multiple
  assign total_blocks = section.blocks.size
%}

<section class="xula-faq" aria-labelledby="{{ heading_id }}">
  <div class="page-width">

    <div class="xula-intro xula-faq__intro">
      {% if section.settings.eyebrow != blank %}
        <span class="xula-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      <h2 class="xula-heading" id="{{ heading_id }}">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.text != blank %}
        <p class="xula-text xula-faq__subtitle">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% if total_blocks > 0 %}
      <div class="xula-faq__list" data-xula-faq data-allow-multiple="{{ allow_multiple }}">
        {% for block in section.blocks %}
          {% if block.type == 'question' %}
            {% liquid
              assign question_id = 'xula-faq-q-' | append: section.id | append: '-' | append: forloop.index
              assign panel_id = 'xula-faq-a-' | append: section.id | append: '-' | append: forloop.index
              assign is_open = false
              if open_first and forloop.first
                assign is_open = true
              endif
            %}
            <details
              class="xula-faq__item"
              data-faq-item
              {% if is_open %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary
                class="xula-faq__summary"
                id="{{ question_id }}"
                data-faq-summary
                aria-controls="{{ panel_id }}"
                aria-expanded="{{ is_open }}"
              >
                <span class="xula-faq__question-text">{{ block.settings.question }}</span>
                <span class="xula-faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>

              <div
                class="xula-faq__panel"
                id="{{ panel_id }}"
                data-faq-panel
                role="region"
                aria-labelledby="{{ question_id }}"
              >
                <div class="xula-faq__answer">
                  {{ block.settings.answer }}
                </div>
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_contact_cta %}
      <div class="xula-faq__cta">
        {% if section.settings.contact_heading != blank %}
          <p class="xula-faq__cta-heading">{{ section.settings.contact_heading }}</p>
        {% endif %}

        {% if section.settings.contact_text != blank %}
          <p class="xula-faq__cta-text">{{ section.settings.contact_text }}</p>
        {% endif %}

        {% if section.settings.contact_button_label != blank and section.settings.contact_button_link != blank %}
          <a href="{{ section.settings.contact_button_link }}" class="xula-btn">
            <span>{{ section.settings.contact_button_label }}</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% if total_blocks > 0 %}
  {% liquid
    assign json_index = 0
  %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
            {%- assign json_index = json_index | plus: 1 -%}
            {%- unless json_index == 1 -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | strip_newlines | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
              }
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Xula FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before You Brew the Perfect Morning"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtitle",
      "default": "We answer the most common questions about shipping, grind, freshness, and the origin of our coffee."
    },
    {
      "type": "header",
      "content": "Accordion behavior"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "allow_multiple",
      "label": "Allow multiple questions open at once",
      "default": false
    },
    {
      "type": "header",
      "content": "Contact call-to-action"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Still have questions?"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Text",
      "default": "Our team is ready to help you find your ideal coffee."
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "label": "Button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does my order take to arrive?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We prepare and ship every order within 24-48 business hours. You'll receive a tracking number to follow your package to your door.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Xula FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long does my order take to arrive?",
            "answer": "<p>We prepare and ship every order within 24-48 business hours. Once shipped, you'll receive a tracking number so you can follow your package in real time right to your door.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I choose the grind type?",
            "answer": "<p>Yes. When choosing your coffee, select the grind that's right for your brew method: whole bean, filter, espresso, or French press. We grind right before packing to lock in every bit of flavor.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How fresh is the coffee I receive?",
            "answer": "<p>We roast in small batches and ship within 7 days of roasting. Every bag is printed with the roast date, so you always know exactly how fresh your coffee is.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where does XULA coffee come from?",
            "answer": "<p>Our coffee comes from high-altitude farms in Mexico, grown by producer families we work with directly. Every purchase directly supports these coffee-growing communities.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
